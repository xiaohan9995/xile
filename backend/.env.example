# ─── 必需配置 ────────────────────────────────────────────────────────────────

# Flask
SECRET_KEY=your-random-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# MySQL (TDSQL-C Serverless on 微信云托管)
MYSQL_DATABASE_URI=mysql+pymysql://root:password@10.0.0.1:3306/xile_yoga?charset=utf8mb4

# ─── 微信小程序 ──────────────────────────────────────────────────────────────

WECHAT_APPID=wxYOUR_APP_ID
WECHAT_SECRET=your_app_secret

# ─── 腾讯云 COS 对象存储 ─────────────────────────────────────────────────────

COS_BUCKET=xile-yoga-1234567890
COS_REGION=ap-shanghai
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 可选配置 ────────────────────────────────────────────────────────────────

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Admin dev token (仅开发环境，生产移除此项以启用真实 JWT)
ADMIN_DEV_TOKEN=dev-admin-token
