# ─── 必需配置 ────────────────────────────────────────────────────────────────

# Flask
SECRET_KEY=your-random-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# MySQL (TDSQL-C Serverless on 微信云托管)
MYSQL_DATABASE_URI=mysql+pymysql://root:password@10.0.0.1:3306/xile_yoga?charset=utf8mb4

# ─── 微信小程序 ──────────────────────────────────────────────────────────────

WECHAT_APPID=wxYOUR_APP_ID
WECHAT_SECRET=your_app_secret

# 与 CloudBase 云函数 mp-auth-bridge 使用同一个随机密钥（至少 32 个字符）
CLOUDBASE_AUTH_BRIDGE_SECRET=generate-a-long-random-secret-here

# ─── 腾讯云 COS 对象存储 ─────────────────────────────────────────────────────

COS_BUCKET=xile-yoga-1234567890
COS_REGION=ap-shanghai
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 可选配置 ────────────────────────────────────────────────────────────────

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Admin dev token (仅开发环境，生产移除此项以启用真实 JWT)
ADMIN_DEV_TOKEN=dev-admin-token

# ─── 生产环境一次性管理员操作 ────────────────────────────────────────────────
# 首次创建管理员：配合 RUN_PRODUCTION_INIT=run-once 使用；成功后应立即移除。
INITIAL_ADMIN_USERNAME=your-first-admin
INITIAL_ADMIN_PASSWORD=use-a-long-unique-password

# 重置 INITIAL_ADMIN_USERNAME 对应的已有管理员密码：
# 配合 RUN_ADMIN_PASSWORD_RESET=run-once 使用；成功后立即移除密码和开关变量。
ADMIN_PASSWORD_RESET_PASSWORD=use-a-long-unique-password
