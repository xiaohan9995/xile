/* ===== Teacher Detail Page ===== */
.detail-page {
  min-height: 100vh;
}

.detail-body {
  padding: 24rpx 32rpx 60rpx;
}

/* ===== Profile head ===== */
.profile-head {
  display: grid;
  grid-template-columns: 152rpx 1fr;
  gap: 32rpx;
  padding: 36rpx 16rpx 28rpx;
  align-items: center;
}

.profile-avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-surface);
  box-sizing: border-box;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.2;
}

.profile-tier {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  color: var(--color-gold);
  font-size: 26rpx;
  font-weight: 700;
}

.level-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-gold);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tier-label {
  color: var(--color-gold);
}

.profile-status {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.profile-status.status-expired {
  color: var(--color-danger);
}

.profile-status.status-expiring {
  color: #c28a1a;
}

/* ===== Info card ===== */
.info-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
}

.info-row {
  display: grid;
  grid-template-columns: 220rpx 1fr;
  gap: 20rpx;
  padding: 12rpx 0;
}

.info-dt {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.55;
}

.info-dd {
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.55;
}

/* ===== Bio card ===== */
.bio-card {
  margin-top: 20rpx;
  padding: 24rpx 28rpx 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
}

.bio-card:active {
  opacity: 0.85;
}

.bio-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
}

.bio-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-muted);
  white-space: pre-wrap;
}

.bio-text--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.bio-toggle {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* ===== Bottom drawer ===== */
.drawer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(20, 28, 23, 0.5);
  display: flex;
  align-items: flex-end;
}

.drawer {
  width: 100%;
  max-height: 72vh;
  background: var(--color-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: drawer-up 0.24s ease;
}

@keyframes drawer-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.drawer__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 8rpx;
  background: var(--color-line);
}

.drawer__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.drawer__title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text);
}

.drawer__close {
  font-size: 32rpx;
  color: var(--color-muted);
  padding: 8rpx;
  line-height: 1;
}

.drawer__body {
  max-height: 56vh;
}

.drawer__text {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--color-text);
  white-space: pre-wrap;
}

/* ===== Certificate card ===== */
.cert-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
}

.cert-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.cert-header:active {
  opacity: 0.7;
}

.cert-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.cert-action {
  font-size: 24rpx;
  color: var(--color-primary);
}

.cert-action:active {
  opacity: 0.6;
}

.cert-preview {
  height: 520rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #f7efe2, #fff);
  border: 1rpx solid rgba(184, 154, 99, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cert-preview:active {
  opacity: 0.85;
}

.cert-preview-text {
  font-size: 26rpx;
  color: var(--color-gold);
  font-weight: 600;
}

.cert-preview-image {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-base);
}

/* ===== Verification note ===== */
.verify-note {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 0 8rpx;
}

.verify-icon {
  font-size: 28rpx;
  line-height: 1;
}

.verify-text {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

/* ===== Loading ===== */
.loading-state {
  margin-top: 120rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-muted);
}
