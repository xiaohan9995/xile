/* ===== 教师详情页 - 严格对照设计稿 ===== */
.detail-page {
  min-height: 100vh;
  background: #F5F5F0;
}

.detail-body {
  padding: 28rpx 28rpx 60rpx;
}

/* 头像区 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  text-align: center;
}

.avatar-box {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #F0F3F1;
  background: #F0F3F1;
}

.check-icon {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  background: #B49658;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}

.teacher-name {
  display: block;
  margin-top: 20rpx;
  color: #333333;
  font-size: 40rpx;
  font-weight: 800;
}

.level-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(180, 150, 88, 0.12);
  color: #B49658;
  font-size: 22rpx;
  font-weight: 700;
}

.level-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #B49658;
}

.teacher-bio {
  display: block;
  margin-top: 20rpx;
  padding: 0 20rpx;
  color: #7E857E;
  font-size: 24rpx;
  line-height: 1.65;
}

/* 信息列表（无分隔线） */
.info-list {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 60rpx;
}

.info-label {
  color: #999999;
  font-size: 24rpx;
  flex-shrink: 0;
}

.info-value {
  color: #333333;
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

/* 证书展示 */
.cert-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.cert-title {
  display: block;
  color: #333333;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.cert-image {
  width: 100%;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F0;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.cert-image image {
  width: 100%;
  height: 100%;
}

.cert-btn {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #F0F3F1;
  color: #5D7261;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 32rpx;
}

/* 联系TA */
.contact-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 32rpx;
  line-height: 88rpx;
  text-align: center;
  background: #5D7261;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 44rpx;
}

.contact-btn:active {
  opacity: 0.9;
}

.error-tip {
  margin-top: 40rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #C84A4A;
  background: #FEF2F2;
  border-radius: 16rpx;
}
