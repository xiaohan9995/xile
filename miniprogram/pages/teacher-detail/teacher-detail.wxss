/* ===== Teacher Detail Page ===== */
.detail-page {
  min-height: 100vh;
}

.detail-body {
  padding: 24rpx 32rpx 60rpx;
}

/* ===== Profile head ===== */
.profile-head {
  display: grid;
  grid-template-columns: 152rpx 1fr;
  gap: 32rpx;
  padding: 36rpx 16rpx 28rpx;
  align-items: center;
}

.profile-avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.2;
}

.profile-tier {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  color: var(--color-gold);
  font-size: 26rpx;
  font-weight: 700;
}

.level-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-gold);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tier-label {
  color: var(--color-gold);
}

.profile-status {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.profile-status.status-expired {
  color: var(--color-danger);
}

.profile-status.status-expiring {
  color: #c28a1a;
}

/* ===== Info card ===== */
.info-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-line);
}

.info-row {
  display: grid;
  grid-template-columns: 144rpx 1fr;
  gap: 20rpx;
  padding: 12rpx 0;
}

.info-dt {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.55;
}

.info-dd {
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.55;
}

/* ===== Certificate card ===== */
.cert-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-line);
}

.cert-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.cert-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.cert-action {
  font-size: 24rpx;
  color: var(--color-primary);
}

.cert-preview {
  height: 152rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f7efe2, #fff);
  border: 1rpx solid rgba(184, 154, 99, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cert-preview-text {
  font-size: 26rpx;
  color: var(--color-gold);
  font-weight: 600;
}

/* ===== Verification note ===== */
.verify-note {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 0 8rpx;
}

.verify-icon {
  font-size: 28rpx;
  line-height: 1;
}

.verify-text {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

/* ===== Loading ===== */
.loading-state {
  margin-top: 120rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-muted);
}
