/* ===== 教师详情页 ===== */
.detail-page {
  min-height: 100vh;
}

.detail-body {
  padding: 24rpx 32rpx 60rpx;
}

/* ===== Profile hero ===== */
.profile-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid var(--color-primary);
}

.avatar-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  border: 4rpx solid var(--color-card);
  background: var(--color-gold);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}

.profile-name {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
}

.profile-tier {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  background: var(--color-gold-light);
  color: var(--color-gold);
  font-size: 24rpx;
  font-weight: 700;
}

.tier-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-gold);
}

.profile-status {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* ===== Info card ===== */
.info-card {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: var(--color-muted);
  font-size: 26rpx;
  flex-shrink: 0;
}

.info-value {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

/* ===== Certification note ===== */
.cert-note {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  text-align: center;
}

.cert-note-text {
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.7;
}

/* ===== Loading ===== */
.loading-state {
  margin-top: 120rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-muted);
}
