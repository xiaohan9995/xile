<view class="detail-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">教师详情</text>
    <view class="page-header__right"></view>
  </view>

  <view wx:if="{{teacher}}" class="detail-body">
    <!-- Profile head -->
    <view class="profile-head">
      <image wx:if="{{teacher.avatarUrl}}" class="profile-avatar" src="{{teacher.avatarUrl}}" mode="aspectFill" />
      <image wx:else class="profile-avatar" src="/assets/xile-yoga-miniapp-avatar.jpg" mode="aspectFill" />
      <view class="profile-info">
        <text class="profile-name">{{teacher.xileName || teacher.realName || teacher.name || '—'}}</text>
        <view class="profile-tier">
          <view class="level-badge">{{teacher.tier || 'L'}}</view>
          <text class="tier-label">{{teacher.tierName || '—'}}</text>
        </view>
        <text class="profile-status {{teacher.certificationStatus === '已过期' ? 'status-expired' : teacher.certificationStatus === '即将到期' ? 'status-expiring' : ''}}">{{teacher.certificationStatus || '未知'}}</text>
      </view>
    </view>

    <!-- Info card -->
    <view class="info-card">
      <view class="info-row">
        <text class="info-dt">喜乐名</text>
        <text class="info-dd">{{teacher.xileName || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">姓名/常用名</text>
        <text class="info-dd">{{commonName || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">认证等级</text>
        <text class="info-dd">{{teacher.tierName || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">首次教师认证年份</text>
        <text class="info-dd">{{firstCertifiedYear || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">当前等级认证年份</text>
        <text class="info-dd">{{currentTierCertifiedYear || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">等级认证有效期至</text>
        <text class="info-dd">{{teacher.validUntil || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">经常居住地</text>
        <text class="info-dd">{{residencesText || '—'}}</text>
      </view>
    </view>

    <!-- Bio -->
    <view class="bio-card" bindtap="toggleBio">
      <text class="bio-title">个人简介</text>
      <text class="bio-text {{bioExpanded ? '' : 'bio-text--clamp'}}">{{teacher.teachingSummary || '暂无个人简介'}}</text>
      <text wx:if="{{teacher.teachingSummary}}" class="bio-toggle">{{bioExpanded ? '收起' : '查看全部'}}</text>
    </view>

    <!-- Certificate card -->
    <view class="cert-card">
      <view class="cert-header" bindtap="previewCertificate">
        <text class="cert-title">证书展示</text>
        <text class="cert-action">查看大图</text>
      </view>
      <view wx:if="{{teacher.teacherNo}}" class="cert-no">
        <text class="cert-no__label">证书编号</text>
        <text class="cert-no__value">{{teacher.teacherNo}}</text>
      </view>
      <view class="cert-preview" bindtap="previewCertificate">
        <image wx:if="{{teacher.certificateUrl}}" class="cert-preview-image" src="{{teacher.certificateUrl}}" mode="aspectFit" />
        <text wx:else class="cert-preview-text">喜乐瑜伽教师认证证书</text>
      </view>
    </view>

    <!-- Verification note -->
    <view class="verify-note">
      <text class="verify-icon">🛡</text>
      <text class="verify-text">该教师资质由喜乐瑜伽教师管理委员会认证维护</text>
    </view>
  </view>

  <!-- Loading state -->
  <view wx:if="{{loading && !teacher}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Error state -->
  <view wx:if="{{error}}" class="error-tip">{{error}}</view>
</view>
