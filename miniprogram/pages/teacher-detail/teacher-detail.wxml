<view class="detail-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">教师详情</text>
    <view class="page-header__right"></view>
  </view>

  <view wx:if="{{teacher}}" class="detail-body">
    <!-- Profile head -->
    <view class="profile-head">
      <image class="profile-avatar" src="{{teacher.avatarUrl}}" mode="aspectFill" />
      <view class="profile-info">
        <text class="profile-name">{{teacher.name}}</text>
        <view class="profile-tier">
          <view class="level-badge">{{teacher.tier || 'L'}}</view>
          <text class="tier-label">认证导师</text>
        </view>
        <text class="profile-status {{teacher.certificationStatus === '已过期' ? 'status-expired' : teacher.certificationStatus === '即将到期' ? 'status-expiring' : ''}}">{{teacher.certificationStatus || '未知'}}</text>
      </view>
    </view>

    <!-- Info card -->
    <view class="info-card">
      <view class="info-row">
        <text class="info-dt">喜乐名</text>
        <text class="info-dd">{{teacher.xileName}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">教师编号</text>
        <text class="info-dd">{{teacher.teacherNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">认证等级</text>
        <text class="info-dd">{{teacher.tierName}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">认证时间</text>
        <text class="info-dd">{{teacher.certifiedAt}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">有效期至</text>
        <text class="info-dd">{{teacher.validUntil}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">所属地区</text>
        <text class="info-dd">{{teacher.city}} {{teacher.district}}</text>
      </view>
      <view class="info-row">
        <text class="info-dt">擅长方向</text>
        <text class="info-dd">{{specialtiesText}}</text>
      </view>
    </view>

    <!-- Certificate card -->
    <view class="cert-card">
      <view class="cert-header" bindtap="previewCertificate">
        <text class="cert-title">证书展示</text>
        <text class="cert-action">查看大图</text>
      </view>
      <view class="cert-preview" bindtap="previewCertificate">
        <image wx:if="{{teacher.certificateUrl}}" class="cert-preview-image" src="{{teacher.certificateUrl}}" mode="aspectFit" />
        <text wx:else class="cert-preview-text">喜乐瑜伽教师认证证书</text>
      </view>
    </view>

    <!-- Verification note -->
    <view class="verify-note">
      <text class="verify-icon">🛡</text>
      <text class="verify-text">该教师资质由喜乐瑜伽教师管理委员会认证维护</text>
    </view>
  </view>

  <!-- Loading state -->
  <view wx:if="{{loading && !teacher}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Error state -->
  <view wx:if="{{error}}" class="error-tip">{{error}}</view>
</view>
