/* ===== Home Page ===== */
.home-page {
  min-height: 100vh;
  background: var(--color-bg);
  overflow-x: hidden;
}

/* ===== Hero Visual ===== */
.home-visual {
  position: relative;
  height: 516rpx;
  overflow: hidden;
}

.home-visual__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-visual__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(247, 244, 238, 0.92) 0%,
    rgba(247, 244, 238, 0) 100%
  );
}

.home-visual__text {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4rpx;
  text-align: center;
  z-index: 2;
}

.home-visual__tagline {
  display: block;
  font-size: 26rpx;
  color: var(--color-muted);
  letter-spacing: 4rpx;
}

/* ===== Body ===== */
.home-body {
  padding: 0 32rpx;
  padding-top: 16rpx;
  padding-bottom: 120rpx;
  position: relative;
  z-index: 3;
}

/* ===== CTA Button ===== */
.cta-btn {
  width: 100%;
  height: 144rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 0 36rpx;
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  border-radius: var(--radius-xl);
  box-sizing: border-box;
}

.cta-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}

.cta-icon-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cta-icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

.cta-text-group {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.cta-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta-subtitle {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ===== Quick Grid ===== */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 152rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-line);
  box-sizing: border-box;
}

.quick-card:active {
  background: #f5f5f3;
  transform: scale(0.98);
}

.quick-card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.quick-card-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* ===== Stats Card ===== */
.stats-card {
  margin-top: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-line);
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.stats-more {
  font-size: 24rpx;
  color: var(--color-muted);
}

.stats-grid {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.2;
}

.stat-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* ===== Notice Card ===== */
.notice-card {
  margin-top: 0;
  padding: 28rpx;
  background: #ffffff;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-line);
}

.notice-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.notice-icon {
  font-size: 28rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-gold);
  flex-shrink: 0;
  margin-top: 12rpx;
}

.notice-content {
  flex: 1;
  min-width: 0;
}

.notice-item-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.notice-item-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== Featured Teachers ===== */
.featured-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-line);
  margin-bottom: 20rpx;
}

.featured-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.featured-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.featured-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.featured-scroll {
  white-space: nowrap;
}

.featured-teacher {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 180rpx;
  margin-right: 24rpx;
}

.featured-teacher:last-child {
  margin-right: 0;
}

.featured-avatar-wrap {
  position: relative;
}

.featured-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-primary-light);
}

.featured-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-light);
}

.featured-avatar-initial {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.featured-name {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160rpx;
}

.featured-tier {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-gold);
  font-weight: 600;
}
