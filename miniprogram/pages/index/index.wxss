/* ===== Home Page ===== */
.home-page {
  min-height: 100vh;
  background: var(--color-bg);
  overflow-x: hidden;
}

/* ===== Hero Visual ===== */
.home-visual {
  position: relative;
  height: 536rpx;
  overflow: hidden;
}

.home-visual__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-visual__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, rgba(25, 51, 36, 0.88) 0%, rgba(48, 86, 61, 0.54) 58%, rgba(48, 86, 61, 0.24) 100%);
}

.home-visual__text {
  position: absolute;
  left: 0;
  right: 0;
  left: 40rpx;
  right: 40rpx;
  bottom: 56rpx;
  text-align: left;
  z-index: 2;
}

.home-visual__tagline {
  display: block;
  font-size: 24rpx;
  margin-top: 16rpx;
  color: rgba(255,255,255,.75);
  letter-spacing: 3rpx;
}
.home-visual__eyebrow { display:block; color:#f3e5c9; font-size:22rpx; font-weight:700; letter-spacing:2rpx; }
.home-visual__title { display:block; margin-top:16rpx; color:#fff; font-family:inherit; font-size:52rpx; font-weight:700; line-height:1.25; }

/* ===== Body ===== */
.home-body {
  padding: 0 32rpx;
  padding-top: 28rpx;
  padding-bottom: 120rpx;
  position: relative;
  z-index: 3;
}
.home-intro { display:flex; flex-direction:column; align-items:flex-start; margin:0 4rpx 22rpx; }
.home-intro .section-title { margin-top:8rpx; }
.home-intro__note { margin-top:12rpx; color:var(--color-muted); font-size:25rpx; line-height:1.65; }

/* ===== CTA Button ===== */
.cta-btn {
  /* Keep exactly the same width as .quick-grid. WXSS does not reliably
     support viewport-unit calculations on every base library version. */
  width: 100%;
  min-width: 100%;
  max-width: none;
  align-self: stretch;
  margin: 0;
  min-height: 176rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 40rpx;
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-elevated);
  box-sizing: border-box;
}
.cta-arrow { color:#fff; font-size:56rpx; font-weight:300; }

.cta-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}

.cta-icon-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cta-icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

.cta-text-group {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.cta-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ===== Quick Grid ===== */
.quick-grid {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  gap: 20rpx;
  margin-top: 24rpx;
}

.quick-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  flex: 1;
  min-height: 176rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
  box-sizing: border-box;
}
.quick-card:active {
  background: var(--color-primary-light);
  transform: scale(0.98);
}

.quick-card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.quick-card-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

/* ===== Stats Card ===== */
.stats-card {
  margin-top: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-line);
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.stats-more {
  font-size: 24rpx;
  color: var(--color-muted);
}

.stats-grid {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.2;
}

.stat-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* ===== Notice Card ===== */
.notice-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-line);
}

.notice-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.notice-icon {
  font-size: 28rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-gold);
  flex-shrink: 0;
  margin-top: 12rpx;
}

.notice-content {
  flex: 1;
  min-width: 0;
}

.notice-item-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.notice-item-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== Featured Teachers ===== */
.featured-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-line);
  margin-bottom: 20rpx;
}

.featured-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.featured-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.featured-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.featured-scroll {
  white-space: nowrap;
}

.featured-scroll__content {
  display: inline-flex;
  align-items: center;
  min-width: 100%;
}

.featured-teacher {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 180rpx;
  margin-right: 24rpx;
}

.featured-teacher:last-child {
  margin-right: 0;
}

.featured-avatar-wrap {
  position: relative;
}

.featured-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-primary-light);
}

.featured-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-light);
}

.featured-avatar-initial {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.featured-name {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160rpx;
}

.featured-tier {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-gold);
  font-weight: 600;
}

.featured-load-more {
  display: inline-flex;
  align-items: center;
  min-width: 138rpx;
  height: 132rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
  white-space: normal;
}

.homepage-state { padding: 34rpx 0 12rpx; color: var(--color-muted); font-size: 24rpx; text-align: center; }
.homepage-state--retry { color: var(--color-primary-dark); }
