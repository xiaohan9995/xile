/* ===== Home Page ===== */
.home-page {
  min-height: 100vh;
  background: var(--color-bg);
  overflow-x: hidden;
}

/* ===== Hero Visual ===== */
.home-visual {
  position: relative;
  height: 258px;
  overflow: hidden;
}

.home-visual__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-visual__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(247, 244, 238, 0.92) 0%,
    rgba(247, 244, 238, 0) 100%
  );
}

.home-visual__text {
  position: absolute;
  left: 32px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
}

.home-visual__title {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.4;
  font-family: "Noto Serif SC", serif;
  white-space: pre-line;
}

.home-visual__tagline {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  color: var(--color-muted);
  letter-spacing: 2px;
}

/* ===== Body (overlaps hero) ===== */
.home-body {
  margin-top: -36rpx;
  padding: 0 32rpx;
  padding-bottom: 120rpx;
  position: relative;
  z-index: 3;
}

/* ===== CTA Button ===== */
.cta-btn {
  width: 100%;
  height: 72px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 18px;
  background: linear-gradient(135deg, #5f7365, #849481);
  border-radius: 16px;
  box-sizing: border-box;
}

.cta-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}

.cta-icon-box {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cta-icon {
  font-size: 16px;
  color: #FFFFFF;
}

.cta-text-group {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.cta-title {
  font-size: 16px;
  font-weight: 700;
  color: #FFFFFF;
}

.cta-subtitle {
  margin-top: 2px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
}

/* ===== Quick Grid ===== */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 20rpx;
}

.quick-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 76px;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16px;
  border: 1px solid rgba(31, 37, 33, 0.08);
  box-sizing: border-box;
}

.quick-card:active {
  background: #f5f5f3;
  transform: scale(0.98);
}

.quick-card-title {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: var(--color-text);
}

.quick-card-desc {
  display: block;
  margin-top: 6px;
  font-size: 11px;
  color: var(--color-muted);
}

/* ===== Stats Card ===== */
.stats-card {
  margin-top: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16px;
  border: 1px solid rgba(31, 37, 33, 0.08);
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-text);
}

.stats-more {
  font-size: 12px;
  color: var(--color-muted);
}

.stats-grid {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 24px;
  font-weight: 900;
  color: var(--color-text);
  line-height: 1.2;
}

.stat-label {
  margin-top: 6px;
  font-size: 11px;
  color: var(--color-muted);
}

