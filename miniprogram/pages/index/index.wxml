<view class="home-page">
  <!-- Hero visual -->
  <view class="home-visual">
    <image class="home-visual__img" src="{{homeBanner || 'https://images.unsplash.com/photo-1545389336-cf090694435e?auto=format&fit=crop&w=640&q=80'}}" mode="aspectFill" alt="" />
    <view class="home-visual__overlay"></view>
    <view class="home-visual__text">
      <text class="home-visual__eyebrow">JOY YOGA · TEACHER CERTIFICATION</text>
      <text class="home-visual__title">喜乐瑜伽 · 教师认证中心</text>
      <text class="home-visual__tagline">喜乐智慧 · 凤凰传承</text>
    </view>
  </view>

  <!-- Body content -->
  <view class="home-body">
    <view class="home-intro">
      <text class="section-title">喜乐瑜伽教师管理认证</text>
      <text class="home-intro__note">浪漫开悟  智慧勇敢  富贵成佛  慈悲爱心</text>
    </view>

    <button class="cta-btn" bindtap="goMyCert">
      <view class="cta-text-group"><text class="cta-title">我的认证</text><text class="cta-subtitle">教师可查看证书、提交教学记录及年审申请</text></view>
      <text class="cta-arrow">›</text>
    </button>
    <!-- Announcements -->
    <view class="notice-card" wx:if="{{announcements.length > 0}}">
      <view class="notice-header">
        <text class="notice-icon">📢</text>
        <text class="notice-title">通知公告</text>
      </view>
      <view class="notice-list">
        <view wx:for="{{announcements}}" wx:key="id" class="notice-item">
          <text class="notice-dot"></text>
          <view class="notice-content">
            <text class="notice-item-title">{{item.title}}</text>
            <text class="notice-item-desc" wx:if="{{item.content}}">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Quick grid: 2x2 -->
    <view class="quick-grid">
      <button class="quick-card" bindtap="goSearch">
        <text class="quick-card-title">教师查询</text>
        <text class="quick-card-desc">查询认证教师信息</text>
      </button>
      <button class="quick-card" bindtap="goStudios">
        <text class="quick-card-title">瑜伽工作室</text>
        <text class="quick-card-desc">查询各地喜乐瑜伽场馆</text>
      </button>
    </view>

    <!-- Affirmation -->
    <view class="affirmation">
      <view class="affirmation__orn">
        <view class="affirmation__orn-line"></view>
        <text class="affirmation__orn-star">✦</text>
        <view class="affirmation__orn-line"></view>
      </view>
      <text class="affirmation__title">我是被认证的喜乐菩萨</text>
      <text class="affirmation__line">我自豪地赞叹自己的选择</text>
      <text class="affirmation__line">我全然地安住在喜乐智慧的祝福中</text>
    </view>

    <view class="homepage-state" wx:if="{{homepageLoading}}"><text>正在加载认证内容</text></view>
    <view class="homepage-state homepage-state--retry" wx:elif="{{homepageLoadError}}" bindtap="retryHomepage"><text>内容加载失败，轻触重新加载</text></view>
  </view>
<tab-bar active="home" />
</view>
