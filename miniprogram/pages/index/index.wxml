<view class="home-page">
  <!-- Hero visual -->
  <view class="home-visual">
    <image class="home-visual__img" src="https://images.unsplash.com/photo-1545389336-cf090694435e?auto=format&fit=crop&w=640&q=80" mode="aspectFill" />
    <view class="home-visual__overlay"></view>
    <view class="home-visual__text">
      <text class="home-visual__title">喜乐瑜伽\n教师认证中心</text>
      <text class="home-visual__tagline">成长 · 修习 · 传承</text>
    </view>
  </view>

  <!-- Body content overlapping hero -->
  <view class="home-body">
    <!-- CTA: 教师查询 -->
    <button class="cta-btn" bindtap="goSearch">
      <view class="cta-icon-box">
        <text class="cta-icon">☰</text>
      </view>
      <view class="cta-text-group">
        <text class="cta-title">教师查询</text>
        <text class="cta-subtitle">查认证教师信息</text>
      </view>
    </button>

    <!-- Quick grid -->
    <view class="quick-grid">
      <view class="quick-card" bindtap="goMyCert">
        <text class="quick-card-title">我的认证</text>
        <text class="quick-card-desc">查看个人认证信息</text>
      </view>
      <view class="quick-card" bindtap="goStudios">
        <text class="quick-card-title">瑜伽工作室</text>
        <text class="quick-card-desc">查看附近认证场馆</text>
      </view>
      <view class="quick-card" bindtap="goYouzan">
        <text class="quick-card-title">有赞学堂</text>
        <text class="quick-card-desc">课程与培训资讯</text>
      </view>
    </view>

    <!-- Stats card -->
    <view class="stats-card">
      <view class="stats-header">
        <text class="stats-title">数据统计</text>
        <text class="stats-more">查看更多</text>
      </view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-num">{{stats.totalTeachers}}</text>
          <text class="stat-label">认证教师总数</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{stats.completedReviews}}</text>
          <text class="stat-label">本年度完成年审</text>
        </view>
      </view>
    </view>
  </view>
<tab-bar active="home" />
</view>
