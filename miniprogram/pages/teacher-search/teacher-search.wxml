<view class="search-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">教师查询</text>
    <view class="page-header__right"></view>
  </view>

  <!-- Search box -->
  <view class="search-section">
    <view class="search-box">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="请输入姓名 / 喜乐名 / 编号"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="doSearch"
      />
      <view class="search-btn" bindtap="doSearch">
        <text class="search-btn-icon">🔍</text>
      </view>
    </view>

    <!-- Filter row -->
    <view class="filter-row">
      <view
        wx:for="{{filters}}"
        wx:key="value"
        class="filter-pill {{activeFilter === item.value ? 'filter-pill--active' : ''}}"
        bindtap="onFilterTap"
        data-filter="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- Teacher cards -->
  <view class="teacher-list">
    <view
      wx:for="{{teachers}}"
      wx:key="id"
      class="teacher-card"
      bindtap="openTeacher"
      data-id="{{item.id}}"
    >
      <image class="card-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view class="card-body">
        <text class="card-name">{{item.name}}</text>
        <text class="card-xile">喜乐名：{{item.xileName}}</text>
        <view class="card-cert-status">
          <text class="card-cert-icon">🛡</text>
          <text class="card-cert-text">{{item.statusText || '认证有效'}}</text>
        </view>
        <text class="card-meta">认证编号 {{item.teacherNo}}</text>
        <text class="card-meta">有效期至 {{item.validUntil}}</text>
      </view>
      <view class="card-level-badge">
        <text class="card-level-text">{{item.tier}}</text>
      </view>
    </view>
  </view>

  <!-- Empty state -->
  <view wx:if="{{!loading && searched && teachers.length === 0}}" class="empty-state">
    <text class="empty-text">未找到匹配教师</text>
  </view>

  <!-- Hint -->
  <view wx:if="{{!loading && !searched && teachers.length === 0}}" class="empty-state">
    <text class="empty-text">没有更多数据了</text>
  </view>

  <!-- Error -->
  <view wx:if="{{error}}" class="error-tip">{{error}}</view>

  <tab-bar active="" />
</view>
