<view class="search-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">教师查询</text>
    <view class="page-header__right"></view>
  </view>

  <!-- Search box -->
  <view class="search-section">
    <view class="search-mode-row">
      <view wx:for="{{searchModes}}" wx:key="id" class="search-mode {{searchMode === item.id ? 'search-mode--active' : ''}}" bindtap="switchMode" data-mode="{{item.id}}">{{item.label}}</view>
    </view>
    <!-- 关键词搜索框：按姓名 / 证书编号 / 地区 三种模式均可用 -->
    <view class="search-box" wx:if="{{searchMode === 'name' || searchMode === 'certificate' || searchMode === 'region'}}">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="{{searchMode === 'certificate' ? '请输入完整教师证书编号' : (searchMode === 'region' ? '请输入地区，如 北京 / 上海' : '请输入教师姓名或喜乐名')}}"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="doSearch"
      />
      <view class="search-btn" bindtap="doSearch">
        <text class="search-btn-icon">🔍</text>
      </view>
    </view>

    <!-- 过滤行：仅「按认证等级」显示等级 picker；「按地区」已改为关键词搜索，不再显示“浏览全部” -->
    <view class="filter-row" wx:if="{{searchMode === 'tier'}}">
      <picker mode="selector" range="{{tierOptions}}" value="{{tierIndex}}" bindchange="onTierChange">
        <view class="filter-pill {{tierIndex > 0 ? 'filter-pill--active' : ''}}">
          {{tierIndex > 0 ? tierOptions[tierIndex] : '点击选择认证等级'}}
        </view>
      </picker>
      <view class="filter-pill filter-pill--reset" wx:if="{{tierIndex > 0}}" bindtap="resetFilters">
        重置
      </view>
    </view>
  </view>

  <!-- Skeleton loading -->
  <skeleton wx:if="{{loading && teachers.length === 0}}" type="teacher-list" count="{{4}}" />

  <!-- Teacher cards -->
  <view class="teacher-list" wx:if="{{!loading || teachers.length > 0}}">
    <teacher-card
      wx:for="{{teachers}}"
      wx:key="id"
      teacher="{{item}}"
    />
  </view>

  <!-- Empty state -->
  <view wx:if="{{!loading && searched && teachers.length === 0}}" class="empty-state">
    <text class="empty-text">未找到匹配教师</text>
    <text class="empty-hint">请尝试更换关键词或调整筛选条件</text>
  </view>

  <!-- Load more -->
  <view wx:if="{{loadingMore}}" class="load-more">
    <text class="load-more-text">加载中...</text>
  </view>
  <view wx:elif="{{!hasMore && teachers.length > 0}}" class="load-more">
    <text class="load-more-text">没有更多数据了</text>
  </view>

  <!-- Error -->
  <view wx:if="{{error}}" class="error-tip">{{error}}</view>

  <tab-bar active="teacher" />
</view>
