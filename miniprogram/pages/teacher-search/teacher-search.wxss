/* ===== Teacher Search Page ===== */
.search-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
  overflow-x: hidden;
}

/* ===== Search Section ===== */
.search-section {
  padding: 24rpx 32rpx 0;
}

.search-box {
  display: grid;
  grid-template-columns: 1fr 88rpx;
  height: 88rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  background: #fbfaf7;
  overflow: hidden;
}

.search-input {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  background: transparent;
}

.search-placeholder {
  color: var(--color-muted);
  font-size: 26rpx;
}

.search-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #fff;
}

.search-btn-icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

/* ===== Filter Row ===== */
.filter-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}

.filter-pill {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.62);
}

.filter-pill--active {
  background: rgba(120, 136, 122, 0.12);
  color: var(--color-primary-dark);
  font-weight: 600;
}

/* ===== Teacher List ===== */
.teacher-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== Empty State ===== */
.empty-state {
  margin-top: 80rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 600;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-muted);
}

/* ===== Load More ===== */
.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--color-muted);
}

.error-tip {
  padding: 24rpx 32rpx;
  font-size: 24rpx;
  color: var(--color-danger);
  text-align: center;
}

.card-location-text {
  font-size: 22rpx;
  color: var(--color-muted);
}
