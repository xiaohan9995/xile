/* ===== Teacher Search Page — Prototype Match ===== */
.search-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
  overflow-x: hidden;
}

/* ===== Search Section ===== */
.search-section {
  padding: 24rpx 32rpx 0;
}

.search-box {
  display: grid;
  grid-template-columns: 1fr 84rpx;
  height: 84rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  background: #fbfaf7;
  overflow: hidden;
}

.search-input {
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--color-text);
  background: transparent;
}

.search-placeholder {
  color: var(--color-muted);
  font-size: 26rpx;
}

.search-btn {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #78887A;
  color: #fff;
}

.search-btn-icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

/* ===== Filter Row ===== */
.filter-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}

.filter-pill {
  flex: 1;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-muted);
  background: transparent;
}

.filter-pill--active {
  background: rgba(120, 136, 122, 0.12);
  color: #5f7365;
  font-weight: 600;
}

/* ===== Teacher List ===== */
.teacher-list {
  padding: 0 32rpx;
}

.teacher-card {
  display: grid;
  grid-template-columns: 116rpx 1fr 48rpx;
  gap: 22rpx;
  align-items: start;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 32rpx;
  border: 1rpx solid rgba(31, 37, 33, 0.08);
  box-shadow: 0 10px 24px rgba(31, 37, 33, 0.06);
}

.teacher-card:active {
  transform: scale(0.98);
}

.card-avatar {
  width: 116rpx;
  height: 144rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.card-body {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.card-xile {
  font-size: 22rpx;
  color: var(--color-muted);
}

.card-cert-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 14rpx 0 8rpx;
}

.card-cert-icon {
  font-size: 22rpx;
  line-height: 1;
}

.card-cert-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #5f7365;
}

.card-meta {
  display: block;
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.card-level-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #b89a63;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-level-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ===== Empty State ===== */
.empty-state {
  margin-top: 80rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-muted);
}
