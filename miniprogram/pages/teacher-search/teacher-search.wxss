/* ===== Teacher Search Page ===== */
.search-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
  overflow-x: hidden;
}

/* ===== Search Section ===== */
/* 统一的垂直节奏：区块间距一律 24rpx（模式行下 / 搜索框与筛选行之间 / 筛选区与列表之间） */
.search-section {
  padding: 24rpx 32rpx 24rpx;
}

.search-mode-row { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:24rpx; }
.search-mode { flex:1 1 42%; min-height:72rpx; display:flex; align-items:center; justify-content:center; border-radius:var(--radius-base); background:var(--color-card); border:1rpx solid var(--color-line); color:var(--color-muted); font-size:24rpx; transition:background .2s ease; }
.search-mode:active { background:var(--color-surface); }
.search-mode--active { border-color:var(--color-primary); background:rgba(66,109,88,.1); color:var(--color-primary-dark); font-weight:700; }

.search-box {
  display: grid;
  grid-template-columns: 1fr 88rpx;
  height: 88rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-card);
  overflow: hidden;
}

.search-input {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  background: transparent;
}

.search-placeholder {
  color: var(--color-muted);
  font-size: 26rpx;
}

.search-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #fff;
}

.search-btn:active {
  background: var(--color-primary-dark);
}

.search-btn-icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

/* ===== Filter Row ===== */
.filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* 只留上边距，下边距交给 .search-section 的 padding-bottom，避免叠加 */
  margin: 24rpx 0 0;
}

/* picker is the real flex child (the pill lives inside it); stretch it like one */
.filter-row picker {
  flex: 1;
  min-width: 0;
}

.filter-pill {
  width: 100%;
  height: 80rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.62);
  transition: background 0.2s ease;
  white-space: nowrap;
  overflow: hidden;
}

/* reset stays a compact pill instead of splitting the row 50/50 */
.filter-pill--reset {
  flex: none;
  width: auto;
  padding: 0 44rpx;
}

.filter-pill:active {
  background: rgba(66, 109, 88, 0.12);
}

.filter-pill--active {
  background: rgba(66, 109, 88, 0.14);
  color: var(--color-primary-dark);
  font-weight: 600;
}

/* ===== Teacher List ===== */
.teacher-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ===== Empty State ===== */
/* .empty-state / .empty-text / .empty-hint / .load-more / .error-tip
   are provided globally in app.wxss */

.card-location-text {
  font-size: 22rpx;
  color: var(--color-muted);
}
