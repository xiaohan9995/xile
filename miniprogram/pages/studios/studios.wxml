<view class="page-shell studios-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">瑜伽工作室</text>
    <view class="page-header__right"></view>
  </view>

  <!-- Studio Hero Section -->
  <view class="studio-hero">
    <image class="studio-hero__bg" src="https://images.unsplash.com/photo-1593810450967-f9c42742e326?auto=format&fit=crop&w=760&q=84" mode="aspectFill" />
    <view class="studio-hero__overlay"></view>
    <view class="studio-hero__content">
      <text class="studio-hero__eyebrow">认证场馆</text>
      <text class="studio-hero__heading">找一处安静练习的空间</text>
      <view class="studio-hero__badge">
        <text class="studio-hero__badge-text">已收录 {{studios.length || 36}} 家喜乐瑜伽认证工作室</text>
      </view>
    </view>
  </view>

  <!-- Search Box -->
  <view class="search-box">
    <view class="search-box__inner">
      <input
        class="search-box__input"
        value="{{keyword}}"
        placeholder="搜索工作室名称或地区"
        placeholder-class="search-box__placeholder"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="loadStudios"
      />
      <view class="search-box__btn" bindtap="loadStudios">
        <text class="search-box__btn-icon">⌕</text>
      </view>
    </view>
  </view>

  <!-- Filter Row -->
  <scroll-view scroll-x class="filter-row" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{cityOptions}}"
      wx:key="value"
      class="filter-pill {{activeCity === item.value ? 'filter-pill--active' : ''}}"
      data-city="{{item.value}}"
      bindtap="changeCity"
    >{{item.label}}</view>
  </scroll-view>

  <!-- Studio Cards -->
  <skeleton wx:if="{{loading && studios.length === 0}}" type="studio-list" count="{{3}}" />

  <view class="studio-list" wx:if="{{!loading || studios.length > 0}}">
    <studio-card
      wx:for="{{studios}}"
      wx:key="id"
      studio="{{item}}"
    />
  </view>

  <!-- Empty State -->
  <view wx:if="{{!loading && studios.length === 0}}" class="empty-card">
    <text class="empty-icon">🧘</text>
    <text class="empty-title">未找到匹配的工作室</text>
    <text class="empty-desc">试试切换城市或修改搜索关键词</text>
    <view class="empty-action" bindtap="resetFilters">查看全部工作室</view>
  </view>

  <!-- Load more -->
  <view wx:if="{{loadingMore}}" class="load-more">
    <text class="load-more-text">加载中...</text>
  </view>
  <view wx:elif="{{!hasMore && studios.length > 0}}" class="load-more">
    <text class="load-more-text">没有更多数据了</text>
  </view>
<tab-bar active="studio" />
</view>
