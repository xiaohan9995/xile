/* ===== Studios Page ===== */
.studios-page {
  padding-top: 0;
}

/* ---- Studio Hero Section ---- */
.studio-hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  min-height: 304rpx;
  border-radius: 48rpx;
  overflow: hidden;
  padding: 40rpx 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-shadow: var(--shadow-elevated);
}

.studio-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.studio-hero__content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.studio-hero__eyebrow {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 3rpx;
}

.studio-hero__heading {
  display: block;
  font-family: "Noto Serif SC", serif;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.32;
  color: #fff;
  white-space: nowrap;
}

.studio-hero__badge {
  display: inline-flex;
  align-self: flex-start;
  margin: 24rpx 32rpx 0;
  padding: 16rpx 28rpx;
  border-radius: var(--radius-full);
  background: rgba(66, 109, 88, 0.14);
}

.studio-hero__badge-text {
  font-size: 24rpx;
  color: #1c2a22;
  font-weight: 500;
}

/* ---- Search Box ---- */
.search-box {
  margin: 32rpx 32rpx 0;
}

.search-box__inner {
  display: grid;
  grid-template-columns: 1fr 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
  background: var(--color-card);
  overflow: hidden;
}

.search-box__input {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.search-box__placeholder {
  color: var(--color-muted);
}

.search-box__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(66, 109, 88, 0.14);
  color: var(--color-primary-dark);
}

.search-box__btn:active {
  background: rgba(66, 109, 88, 0.22);
}

.search-box__btn-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid var(--color-primary-dark);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-box__btn-icon::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 14rpx;
  height: 4rpx;
  background: var(--color-primary-dark);
  border-radius: 2rpx;
  transform: rotate(45deg);
  transform-origin: left center;
}

/* ---- Filter Row ---- */
.filter-row {
  white-space: nowrap;
  padding: 24rpx 32rpx 16rpx;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.62);
  color: var(--color-muted);
  font-size: 26rpx;
  font-weight: 500;
  transition: background 0.2s ease;
}

.filter-pill:active {
  background: rgba(66, 109, 88, 0.12);
}

.filter-pill--active {
  background: rgba(66, 109, 88, 0.14);
  color: var(--color-primary-dark);
  font-weight: 600;
}

/* ---- Studio Cards ---- */
.studio-list {
  padding: 8rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ---- Empty State ---- */
.empty-card {
  margin: 40rpx 32rpx;
  padding: 80rpx 40rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.empty-action {
  margin-top: 28rpx;
  padding: 12rpx 36rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.empty-action:active {
  opacity: 0.85;
}

