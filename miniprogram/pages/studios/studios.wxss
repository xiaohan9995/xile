/* ===== Studios List Page ===== */
.studios-page {
  padding-top: 0;
}

/* Hero Banner */
.hero-banner {
  position: relative;
  height: 360rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 32rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(31, 37, 33, 0.6) 100%);
}

.hero-title {
  display: block;
  color: #fff;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.hero-sub {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

/* Search */
.search-wrap {
  padding: 24rpx 28rpx 0;
  margin-top: -36rpx;
  position: relative;
  z-index: 5;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 40rpx;
  border: 1rpx solid var(--brand-line);
  box-shadow: 0 8rpx 24rpx rgba(93, 114, 97, 0.08);
}

.search-icon {
  font-size: 32rpx;
  color: var(--brand-muted);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  color: var(--brand-ink);
}

.search-placeholder {
  color: #b0b8b1;
}

/* City Pills */
.city-pills {
  white-space: nowrap;
  padding: 24rpx 28rpx 8rpx;
}

.city-pill {
  display: inline-block;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  margin-right: 14rpx;
  border-radius: 28rpx;
  background: #fff;
  color: var(--brand-muted);
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid var(--brand-line);
  transition: all 0.2s ease;
}

.city-pill--active {
  background: var(--brand-green);
  color: #fff;
  border-color: var(--brand-green);
  box-shadow: 0 4rpx 12rpx rgba(123, 158, 122, 0.25);
}

/* Result bar */
.result-bar {
  padding: 16rpx 32rpx 8rpx;
}

.result-count {
  font-size: 22rpx;
  color: var(--brand-muted);
}

/* Studio List */
.studio-list {
  padding: 12rpx 28rpx;
}

.studio-card {
  margin-bottom: 24rpx;
  overflow: hidden;
}

.studio-thumb {
  width: 100%;
  height: 240rpx;
  border-radius: 28rpx 28rpx 0 0;
}

.studio-body {
  padding: 24rpx;
}

.studio-name {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--brand-ink);
}

.studio-location {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--brand-muted);
}

.studio-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.studio-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-gold-light);
  color: var(--brand-gold);
  font-size: 20rpx;
  font-weight: 600;
}

.studio-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.studio-cta {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--brand-green);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.studio-cta:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-ink);
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--brand-muted);
}

.empty-action {
  margin-top: 28rpx;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: var(--brand-green);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

/* Loading */
.loading-wrap {
  padding: 60rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: var(--brand-muted);
}
