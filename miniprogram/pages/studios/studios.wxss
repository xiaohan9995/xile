/* ===== Studios Page ===== */
.studios-page {
  padding-top: 0;
}

/* ---- Studio Hero Section ---- */
.studio-hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  min-height: 304rpx;
  border-radius: 48rpx;
  overflow: hidden;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-shadow: 0 44rpx 84rpx rgba(95, 115, 101, 0.2);
}

.studio-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.studio-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(95, 115, 101, 0.92), rgba(143, 165, 141, 0.58));
}

.studio-hero__content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.studio-hero__eyebrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 2rpx;
}

.studio-hero__heading {
  font-family: "Noto Serif SC", serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.32;
  color: #fff;
}

.studio-hero__badge {
  display: inline-flex;
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
}

.studio-hero__badge-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
}

/* ---- Search Box ---- */
.search-box {
  margin: 32rpx 32rpx 0;
}

.search-box__inner {
  display: grid;
  grid-template-columns: 1fr 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--color-line);
  background: #fff;
  overflow: hidden;
}

.search-box__input {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.search-box__placeholder {
  color: var(--color-muted);
}

.search-box__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-dark);
  color: #fff;
}

.search-box__btn-icon {
  font-size: 32rpx;
  color: #fff;
}

/* ---- Filter Row ---- */
.filter-row {
  white-space: nowrap;
  padding: 24rpx 32rpx 16rpx;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.62);
  color: var(--color-muted);
  font-size: 26rpx;
  font-weight: 500;
}

.filter-pill--active {
  background: rgba(143, 165, 141, 0.18);
  color: var(--color-primary-dark);
  font-weight: 600;
}

/* ---- Studio Cards ---- */
.studio-list {
  padding: 8rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ---- Empty State ---- */
.empty-card {
  margin: 40rpx 32rpx;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 32rpx;
  border: 1rpx solid var(--color-line);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.empty-action {
  margin-top: 28rpx;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: var(--color-primary-dark);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

/* ---- Loading ---- */
.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--color-muted);
}
