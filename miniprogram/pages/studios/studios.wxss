/* ===== 瑜伽工作室列表页 - 严格对齐设计稿 ===== */
.studios-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: #F5F5F0;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 28rpx;
  height: 76rpx;
  background: #fff;
  border-radius: 38rpx;
  border: 1rpx solid rgba(123, 158, 122, 0.12);
  padding: 0 6rpx;
}

.search-bar input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  color: #333;
}

.search-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #7B9E7A;
  color: #fff;
  font-size: 30rpx;
  border-radius: 50%;
}

/* 城市筛选 */
.city-scroll {
  white-space: nowrap;
  padding: 0 28rpx;
}

.city-scroll::-webkit-scrollbar { display: none; }

.city-chip {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 26rpx;
  margin-right: 14rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #7E857E;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
}

.city-chip.active {
  background: #7B9E7A;
  color: #fff;
}

/* 列表元信息 */
.list-meta {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  font-size: 22rpx;
  color: #999;
}

/* 工作室列表 */
.studio-list {
  padding: 0 28rpx;
  max-height: calc(100vh - 480rpx);
}

.studio-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(123, 158, 122, 0.06);
}

.studio-cover {
  width: 100%;
  height: 240rpx;
}

.studio-info {
  padding: 22rpx 24rpx;
}

.studio-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.studio-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.studio-rating {
  color: #B49658;
  font-size: 22rpx;
  font-weight: 700;
}

.studio-addr {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7E857E;
}

.studio-intro {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.studio-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #F7F4EF;
  color: #B49658;
  font-size: 18rpx;
  font-weight: 600;
}

/* 空状态 */
.empty-box {
  margin-top: 60rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.empty-btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 12rpx 32rpx;
  background: #7B9E7A;
  color: #fff;
  font-size: 24rpx;
  border-radius: 28rpx;
}

/* ===== 底部TabBar ===== */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.95);
  border-top: 1rpx solid rgba(123, 158, 122, 0.1);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon { font-size: 32rpx; color: #999; }
.tab-label { font-size: 20rpx; color: #999; }
