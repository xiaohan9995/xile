<view class="page-shell studio-detail-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">工作室详情</text>
    <view class="page-header__right"></view>
  </view>

  <view wx:if="{{studio}}" class="detail-content animate-fade-in">
    <!-- Image Carousel -->
    <view class="cover-section">
      <swiper wx:if="{{studio.images.length > 1}}" class="cover-swiper" indicator-dots indicator-active-color="#ffffff" circular autoplay interval="4000">
        <swiper-item wx:for="{{studio.images}}" wx:key="*this">
          <image class="cover-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
      <image wx:else class="cover-image" src="{{studio.images[0] || studio.coverImage}}" mode="aspectFill" />
      <view class="cover-gradient">
        <view class="cover-badge-row">
          <text class="cover-status badge-green">{{studio.status || '开放中'}}</text>
        </view>
      </view>
    </view>

    <!-- Studio Info Card -->
    <view class="info-card soft-card">
      <text class="info-name serif">{{studio.name}}</text>
      <text class="info-location">{{studio.city}} · {{studio.district}}</text>

      <!-- Tags -->
      <view class="info-tags" wx:if="{{studio.tags.length}}">
        <text wx:for="{{studio.tags}}" wx:key="*this" class="info-tag">{{item}}</text>
      </view>
    </view>

    <!-- 主理教师：与下方「工作室介绍」同款卡片样式，点选进入教师详情抽屉。
         置于「工作室介绍」正上方，先看人再看介绍。 -->
    <view class="info-grid lead-teachers">
      <view class="grid-item soft-card">
        <text class="grid-icon">👩‍🏫</text>
        <view class="grid-text">
          <text class="grid-label">主理教师</text>
          <view class="lead-teacher-row">
            <view class="lead-teacher" wx:for="{{studio.ownerTeachers}}" wx:key="id" bindtap="openTeacherDrawer" data-id="{{item.id}}">
              <image wx:if="{{item.avatarUrl}}" class="lead-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
              <image wx:else class="lead-avatar" src="/assets/xile-yoga-miniapp-avatar.jpg" mode="aspectFill" />
              <text class="lead-name">{{item.name || item.xileName}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Info Grid -->
    <view class="info-grid">
      <view class="grid-item soft-card" bindtap="openCourseDrawer">
        <text class="grid-icon">📚</text>
        <view class="grid-text">
          <text class="grid-label">工作室介绍</text>
          <text class="grid-value grid-value--clamp">{{studio.courseIntro || '暂无课程介绍'}}</text>
        </view>
        <text class="grid-arrow">›</text>
      </view>
      <view class="grid-item soft-card" bindtap="openMap">
        <text class="grid-icon">📍</text>
        <view class="grid-text">
          <text class="grid-label">地址</text>
          <text class="grid-value">{{studio.address || '暂无地址信息'}}</text>
        </view>
      </view>
    </view>

    <!-- 联系工作室：与「修改工作室信息」所在卡片同款卡片容器，点选后从底部
         弹出抽屉，展示联系电话与微信二维码（主理教师上传的联系图片）。 -->
    <view class="contact-panel">
      <button class="contact-button" bindtap="openContactDrawer">联系工作室</button>
    </view>

    <!-- 主理教师管理入口：仅当当前登录用户是该工作室主理教师时显示 -->
    <view wx:if="{{mine}}" class="owner-panel">
      <view wx:if="{{mine.status === 'pending'}}" class="owner-panel__status">
        <text>该工作室信息正在等待管理员审批</text>
      </view>
      <view wx:if="{{mine.rejectReason}}" class="owner-panel__reject">
        <text class="owner-panel__reject-label">驳回原因</text>
        <text>{{mine.rejectReason}}</text>
      </view>
      <view class="owner-panel__actions">
        <button wx:if="{{mine.status === 'pending'}}" class="btn-secondary owner-panel__action" bindtap="withdraw">撤回提交</button>
        <button class="btn-primary owner-panel__action" bindtap="goEdit">
          {{mine.status === 'pending' ? '查看/修改提交' : (mine.status === 'open' ? '修改工作室信息' : '填写工作室信息')}}
        </button>
      </view>
      <view wx:if="{{mine.manager}}" class="owner-panel__manage">
        <button class="btn-secondary owner-panel__action" bindtap="goManageTeachers">管理教师</button>
      </view>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text animate-pulse">加载中...</text>
  </view>

  <!-- Error -->
  <view wx:if="{{error}}" class="error-wrap">
    <text class="error-text">{{error}}</text>
  </view>

  <!-- Contact drawer：联系电话 + 微信二维码（主理教师上传的联系图片） -->
  <view wx:if="{{contactDrawerVisible}}" class="drawer-mask" bindtap="closeContactDrawer">
    <view class="drawer drawer--contact" catchtap="noop">
      <view class="drawer__grip">
        <view class="drawer__handle"></view>
      </view>
      <view class="drawer__head">
        <text class="drawer__title">联系工作室</text>
        <view class="drawer__close" bindtap="closeContactDrawer">✕</view>
      </view>
      <scroll-view scroll-y class="drawer__body" enhanced show-scrollbar="{{false}}">
        <!-- 电话：点选直接调起系统拨号盘，右侧「复制」按钮单独复制号码 -->
        <view wx:if="{{studio.contactText}}" class="contact-drawer__section">
          <view class="contact-drawer__section-title">
            <text class="contact-drawer__section-bar"></text>
            <text>联系电话</text>
          </view>
          <view class="contact-drawer__card contact-drawer__phone" bindtap="callContact">
            <view class="contact-drawer__phone-main">
              <text class="contact-drawer__phone-text">{{studio.contactText}}</text>
            </view>
            <view class="contact-drawer__phone-action" catchtap="copyContact">复制</view>
          </view>
        </view>

        <!-- 微信二维码：主理教师上传的联系图片，点选可查看大图 -->
        <view class="contact-drawer__section">
          <view class="contact-drawer__section-title">
            <text class="contact-drawer__section-bar"></text>
            <text>微信二维码</text>
            <text wx:if="{{studio.contactImage}}" class="contact-drawer__section-action" bindtap="previewContactImage">查看大图</text>
          </view>
          <view class="contact-drawer__qr" bindtap="previewContactImage">
            <image wx:if="{{studio.contactImage}}" class="contact-drawer__qr-image" src="{{studio.contactImage}}" mode="aspectFit" show-menu-by-longpress />
            <view wx:else class="contact-drawer__qr-empty">
              <text class="contact-drawer__qr-empty-icon">💬</text>
              <text class="contact-drawer__qr-empty-text">该工作室暂未上传联系图片</text>
            </view>
          </view>
          <text wx:if="{{studio.contactImage}}" class="contact-drawer__qr-hint">长按图片可保存或转发</text>
        </view>

        <!-- 认证背书：与教师详情页 verify-note 一致 -->
        <view class="contact-drawer__verify">
          <text class="contact-drawer__verify-icon">🛡</text>
          <text class="contact-drawer__verify-text">联系方式由该工作室主理教师提供并经喜乐瑜伽教师管理委员会审核</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- Course intro drawer -->
  <view wx:if="{{courseDrawerVisible}}" class="drawer-mask" bindtap="closeCourseDrawer">
    <view class="drawer drawer--course" catchtap="noop">
      <view class="drawer__grip">
        <view class="drawer__handle"></view>
      </view>
      <view class="drawer__head">
        <text class="drawer__title">课程介绍</text>
        <view class="drawer__close" bindtap="closeCourseDrawer">✕</view>
      </view>
      <scroll-view scroll-y class="drawer__body" enhanced show-scrollbar="{{false}}">
        <!-- 课程总览：与教师详情页 profile-head 同构，先给整体印象 -->
        <view class="course-drawer__hero">
          <view class="course-drawer__hero-mark">
            <text>课</text>
          </view>
          <view class="course-drawer__hero-info">
            <text class="course-drawer__hero-title">{{studio.name}}</text>
          </view>
        </view>

        <!-- 课程列表：每门课程一张卡片，字段与教师详情页 info-row 一致 -->
        <view wx:for="{{courses}}" wx:key="key" class="course-drawer__section">
          <view class="course-drawer__card">
            <view wx:if="{{item.intro}}" class="course-drawer__row course-drawer__row--block">
              <text class="course-drawer__dt">课程简介</text>
              <text class="course-drawer__dd">{{item.intro}}</text>
            </view>
          </view>
        </view>

        <!-- 空态：未配置课程时给出明确指引 -->
        <view wx:if="{{!courses.length}}" class="course-drawer__empty">
          <text class="course-drawer__empty-text">该工作室暂未发布课程</text>
          <text class="course-drawer__empty-hint">课程信息由主理教师维护，可稍后再来查看</text>
        </view>

        <!-- 认证背书：与教师详情页 verify-note 一致 -->
        <view class="course-drawer__verify">
          <text class="course-drawer__verify-icon">🛡</text>
          <text class="course-drawer__verify-text">课程信息由该工作室主理教师维护并经喜乐瑜伽教师管理委员会审核</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- Teacher detail drawer -->
  <view wx:if="{{teacherDrawerVisible}}" class="drawer-mask" bindtap="closeTeacherDrawer">
    <view class="drawer drawer--teacher" catchtap="noop">
      <view class="drawer__grip">
        <view class="drawer__handle"></view>
      </view>

      <view class="drawer__head">
        <text class="drawer__title">教师详情</text>
        <view class="drawer__close" bindtap="closeTeacherDrawer">✕</view>
      </view>

      <scroll-view scroll-y class="drawer__body" enhanced show-scrollbar="{{false}}">
        <view wx:if="{{teacherLoading}}" class="teacher-drawer__loading">
          <view class="teacher-drawer__skeleton teacher-drawer__skeleton--avatar"></view>
          <view class="teacher-drawer__skeleton-lines">
            <view class="teacher-drawer__skeleton teacher-drawer__skeleton--long"></view>
            <view class="teacher-drawer__skeleton teacher-drawer__skeleton--medium"></view>
          </view>
        </view>

        <view wx:elif="{{selectedTeacher}}" class="teacher-drawer">
          <!-- 1. 身份区：头像 + 名称 + 等级 + 认证状态 -->
          <view class="teacher-drawer__hero">
            <image wx:if="{{selectedTeacher.avatarUrl}}" class="teacher-drawer__avatar" src="{{selectedTeacher.avatarUrl}}" mode="aspectFill" />
            <image wx:else class="teacher-drawer__avatar" src="/assets/xile-yoga-miniapp-avatar.jpg" mode="aspectFill" />

            <view class="teacher-drawer__head-info">
              <text class="teacher-drawer__name">{{selectedTeacher.xileName || selectedTeacher.realName || selectedTeacher.name || '—'}}</text>
              <text class="teacher-drawer__alias" wx:if="{{selectedTeacher.commonName}}">{{selectedTeacher.commonName}}</text>
              <view class="teacher-drawer__meta">
                <view class="teacher-drawer__level-badge">{{selectedTeacher.tier || 'L'}}</view>
                <text class="teacher-drawer__sub">{{selectedTeacher.tierName || '—'}}</text>
                <text class="teacher-drawer__status {{selectedTeacher.certificationStatus === '已过期' ? 'teacher-drawer__status--expired' : selectedTeacher.certificationStatus === '即将到期' ? 'teacher-drawer__status--expiring' : ''}}">{{selectedTeacher.certificationStatus || '未知'}}</text>
              </view>
            </view>
          </view>

          <!-- 2. 认证信息：与教师详情页 info-card 一致，键值行呈现 -->
          <view class="teacher-drawer__section">
            <view class="teacher-drawer__section-title">
              <text class="teacher-drawer__section-bar"></text>
              <text>认证信息</text>
            </view>
            <view class="teacher-drawer__card">
              <view class="teacher-drawer__row">
                <text class="teacher-drawer__dt">首次教师认证年份</text>
                <text class="teacher-drawer__dd">{{selectedTeacher.firstCertifiedYear || '—'}}</text>
              </view>
              <view class="teacher-drawer__row">
                <text class="teacher-drawer__dt">当前等级认证年份</text>
                <text class="teacher-drawer__dd">{{selectedTeacher.currentTierCertifiedYear || '—'}}</text>
              </view>
              <view class="teacher-drawer__row">
                <text class="teacher-drawer__dt">等级认证有效期至</text>
                <text class="teacher-drawer__dd">{{selectedTeacher.validUntil || '—'}}</text>
              </view>
            </view>
          </view>

          <!-- 3. 擅长领域：标签化，便于快速扫读 -->
          <view class="teacher-drawer__section" wx:if="{{selectedTeacher.specialtiesText}}">
            <view class="teacher-drawer__section-title">
              <text class="teacher-drawer__section-bar"></text>
              <text>擅长领域</text>
            </view>
            <view class="teacher-drawer__chips">
              <text wx:for="{{selectedTeacher.specialties}}" wx:key="*this" class="teacher-drawer__chip">{{item}}</text>
            </view>
          </view>

          <!-- 4. 基本信息：次要字段，弱化呈现 -->
          <view class="teacher-drawer__section">
            <view class="teacher-drawer__section-title">
              <text class="teacher-drawer__section-bar"></text>
              <text>基本信息</text>
            </view>
            <view class="teacher-drawer__card">
              <view class="teacher-drawer__row">
                <text class="teacher-drawer__dt">喜乐名</text>
                <text class="teacher-drawer__dd">{{selectedTeacher.xileName || '—'}}</text>
              </view>
              <view class="teacher-drawer__row">
                <text class="teacher-drawer__dt">姓名/常用名</text>
                <text class="teacher-drawer__dd">{{selectedTeacher.commonName || '—'}}</text>
              </view>
              <view class="teacher-drawer__row">
                <text class="teacher-drawer__dt">经常居住地</text>
                <text class="teacher-drawer__dd">{{selectedTeacher.residencesText || '—'}}</text>
              </view>
            </view>
          </view>

          <!-- 5. 个人简介 -->
          <view class="teacher-drawer__section" wx:if="{{selectedTeacher.teachingSummary}}">
            <view class="teacher-drawer__section-title">
              <text class="teacher-drawer__section-bar"></text>
              <text>个人简介</text>
            </view>
            <view class="teacher-drawer__card">
              <text class="teacher-drawer__bio-text {{teacherBioExpanded ? '' : 'teacher-drawer__bio-text--clamp'}}">{{selectedTeacher.teachingSummary}}</text>
              <text class="teacher-drawer__bio-toggle" bindtap="toggleTeacherBio">{{teacherBioExpanded ? '收起' : '查看全部'}}</text>
            </view>
          </view>

          <!-- 6. 证书展示 -->
          <view class="teacher-drawer__section">
            <view class="teacher-drawer__section-title">
              <text class="teacher-drawer__section-bar"></text>
              <text>证书展示</text>
              <text class="teacher-drawer__section-action" wx:if="{{selectedTeacher.certificateUrl}}" bindtap="previewTeacherCertificate">查看大图</text>
            </view>
            <view wx:if="{{selectedTeacher.teacherNo}}" class="teacher-drawer__cert-no">
              <text class="teacher-drawer__cert-no-label">证书编号</text>
              <text class="teacher-drawer__cert-no-value">{{selectedTeacher.teacherNo}}</text>
            </view>
            <view class="teacher-drawer__cert-preview" bindtap="previewTeacherCertificate">
              <image wx:if="{{selectedTeacher.certificateUrl}}" class="teacher-drawer__cert-image" src="{{selectedTeacher.certificateUrl}}" mode="aspectFit" />
              <text wx:else class="teacher-drawer__cert-text">喜乐瑜伽教师认证证书</text>
            </view>
          </view>

          <!-- 7. 认证背书 -->
          <view class="teacher-drawer__verify">
            <text class="teacher-drawer__verify-icon">🛡</text>
            <text class="teacher-drawer__verify-text">该教师资质由喜乐瑜伽教师管理委员会认证维护</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
