<view class="page-shell studio-detail-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">工作室详情</text>
    <view class="page-header__right"></view>
  </view>

  <view wx:if="{{studio}}" class="detail-content animate-fade-in">
    <!-- Image Carousel -->
    <view class="cover-section">
      <swiper wx:if="{{studio.images.length > 1}}" class="cover-swiper" indicator-dots indicator-active-color="#ffffff" circular autoplay interval="4000">
        <swiper-item wx:for="{{studio.images}}" wx:key="*this">
          <image class="cover-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
      <image wx:else class="cover-image" src="{{studio.images[0] || studio.coverImage}}" mode="aspectFill" />
      <view class="cover-gradient">
        <view class="cover-badge-row">
          <text class="cover-status badge-green">{{studio.status || '开放中'}}</text>
        </view>
      </view>
    </view>

    <!-- Studio Info Card -->
    <view class="info-card soft-card">
      <text class="info-name serif">{{studio.name}}</text>
      <text class="info-location">{{studio.city}} · {{studio.district}}</text>

      <!-- Lead Teachers -->
      <view class="lead-teacher" wx:for="{{studio.ownerTeachers}}" wx:key="id">
        <view class="lead-avatar-wrap">
          <text class="lead-icon">👤</text>
        </view>
        <view class="lead-info">
          <text class="lead-label" wx:if="{{index === 0}}">主理教师</text>
          <text class="lead-name">{{item.name || item.xileName}}</text>
          <text class="lead-real-name" wx:if="{{item.realName && item.realName !== item.name}}">{{item.realName}}</text>
        </view>
      </view>

      <!-- Tags -->
      <view class="info-tags" wx:if="{{studio.tags.length}}">
        <text wx:for="{{studio.tags}}" wx:key="*this" class="info-tag">{{item}}</text>
      </view>
    </view>

    <!-- Info Grid -->
    <view class="info-grid">
      <view class="grid-item soft-card" bindtap="openMap">
        <text class="grid-icon">📍</text>
        <view class="grid-text">
          <text class="grid-label">地址</text>
          <text class="grid-value">{{studio.address || '暂无地址信息'}}</text>
        </view>
      </view>
      <view class="grid-item soft-card" bindtap="openCourseDrawer">
        <text class="grid-icon">📚</text>
        <view class="grid-text">
          <text class="grid-label">课程介绍</text>
          <text class="grid-value grid-value--clamp">{{studio.courseIntro || '暂无课程介绍'}}</text>
        </view>
        <text class="grid-arrow" wx:if="{{studio.courseIntro}}">›</text>
      </view>
      <view class="grid-item soft-card" bindtap="callStudio">
        <text class="grid-icon">📞</text>
        <view class="grid-text">
          <text class="grid-label">联系方式</text>
          <text class="grid-value">{{studio.contactText || '微信/电话预约'}}</text>
        </view>
      </view>

      <!-- 咨询服务：与「我的认证」页保持一致，客服会话必须由
           open-type="contact" 的独立 button 承载，无法动态绑定。 -->
      <button
        class="grid-item soft-card"
        open-type="contact"
        session-from="studio-detail"
      >
        <text class="grid-icon">💬</text>
        <view class="grid-text">
          <text class="grid-value">咨询客服</text>
        </view>
      </button>
    </view>

    <!-- 主理教师管理入口：仅当当前登录用户是该工作室主理教师时显示 -->
    <view wx:if="{{mine}}" class="owner-panel">
      <view wx:if="{{mine.status === 'pending'}}" class="owner-panel__status">
        <text>该工作室信息正在等待管理员审批</text>
      </view>
      <view wx:if="{{mine.rejectReason}}" class="owner-panel__reject">
        <text class="owner-panel__reject-label">驳回原因</text>
        <text>{{mine.rejectReason}}</text>
      </view>
      <view class="owner-panel__actions">
        <button wx:if="{{mine.status === 'pending'}}" class="btn-secondary owner-panel__action" bindtap="withdraw">撤回提交</button>
        <button class="btn-primary owner-panel__action" bindtap="goEdit">
          {{mine.status === 'pending' ? '查看/修改提交' : (mine.status === 'open' ? '修改工作室信息' : '填写工作室信息')}}
        </button>
      </view>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text animate-pulse">加载中...</text>
  </view>

  <!-- Error -->
  <view wx:if="{{error}}" class="error-wrap">
    <text class="error-text">{{error}}</text>
  </view>

  <!-- Course intro drawer -->
  <view wx:if="{{courseDrawerVisible}}" class="drawer-mask" bindtap="closeCourseDrawer">
    <view class="drawer" catchtap="noop">
      <view class="drawer__handle"></view>
      <view class="drawer__head">
        <text class="drawer__title">课程介绍</text>
        <text class="drawer__close" bindtap="closeCourseDrawer">✕</text>
      </view>
      <scroll-view scroll-y class="drawer__body">
        <text class="drawer__text">{{studio.courseIntro || '暂无课程介绍'}}</text>
      </scroll-view>
    </view>
  </view>
</view>
