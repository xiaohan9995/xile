/* ===== Studio Detail Page ===== */
.studio-detail-page {
  padding-top: 0;
}

/* Cover */
.cover-section {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.cover-swiper {
  width: 100%;
  height: 100%;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(31, 37, 33, 0.45) 100%);
}

.cover-badge-row {
  display: flex;
  gap: 12rpx;
}

.cover-status {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* Info Card */
.info-card {
  margin: -40rpx 28rpx 24rpx;
  padding: 32rpx;
  position: relative;
  z-index: 5;
}

.info-name {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--color-text);
}

.info-location {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

/* Lead Teacher */
.lead-teachers {
  margin-top: 24rpx;
}

.lead-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-muted);
  margin-bottom: 12rpx;
}

.lead-teacher-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: nowrap;
  overflow-x: auto;
}

.lead-teacher {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: var(--color-primary-light);
  border-radius: 999rpx;
  flex-shrink: 0;
}

.lead-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.lead-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.lead-avatar-initial {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.lead-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  white-space: nowrap;
}

/* Tags */
.info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.info-tag {
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

/* Info Grid */
.info-grid {
  padding: 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grid-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.grid-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.grid-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.grid-label {
  font-size: 22rpx;
  color: var(--color-muted);
  font-weight: 600;
}

.grid-value {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
}

.grid-value--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-weight: 400;
  line-height: 1.6;
}

.grid-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: var(--color-muted);
  margin-left: 8rpx;
}

/* 咨询服务：与上方 .grid-item 卡片同宽同高。承载元素是原生 button，
   需复位 button 默认样式（宽度/内边距/边框/背景/行高）。 */
.info-grid button.grid-item {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  text-align: left;
  line-height: normal;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.info-grid button.grid-item::after {
  border: none;
}

.info-grid button.grid-item:active {
  transform: scale(0.98);
  opacity: 0.84;
}

/* Loading & Error */
.loading-wrap {
  padding: 120rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: var(--color-muted);
}

.error-wrap {
  padding: 60rpx 28rpx;
  text-align: center;
}

/* 主理教师管理入口 */
.owner-panel {
  margin: 24rpx 28rpx 48rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-card);
  box-shadow: var(--shadow-card);
}

.owner-panel__status {
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-base);
  background: var(--color-gold-light);
  color: var(--color-gold);
  font-size: 24rpx;
  font-weight: 600;
}

.owner-panel__reject {
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-base);
  background: rgba(180, 140, 40, 0.10);
  color: #8a6d1c;
  font-size: 24rpx;
  line-height: 1.6;
}

.owner-panel__reject-label {
  display: block;
  margin-bottom: 4rpx;
  font-weight: 700;
}

.owner-panel__action {
  width: 100%;
}

.owner-panel__actions {
  display: flex;
  gap: 16rpx;
}

.owner-panel__actions .owner-panel__action {
  flex: 1;
  margin: 0;
}

/* ===== Bottom drawer ===== */
.drawer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(20, 28, 23, 0.5);
  display: flex;
  align-items: flex-end;
}

.drawer {
  width: 100%;
  max-height: 72vh;
  background: var(--color-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: drawer-up 0.24s ease;
}

@keyframes drawer-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.drawer__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 8rpx;
  background: var(--color-line);
}

.drawer__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.drawer__title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text);
}

.drawer__close {
  font-size: 32rpx;
  color: var(--color-muted);
  padding: 8rpx;
  line-height: 1;
}

.drawer__body {
  max-height: 56vh;
}

.drawer__text {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--color-text);
  white-space: pre-wrap;
}

/* Teacher detail drawer */
.teacher-drawer__head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 24rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.teacher-drawer__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.teacher-drawer__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.teacher-drawer__head-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.teacher-drawer__name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text);
}

.teacher-drawer__sub {
  font-size: 24rpx;
  color: var(--color-muted);
}

.teacher-drawer__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.teacher-drawer__dt {
  font-size: 24rpx;
  color: var(--color-muted);
}

.teacher-drawer__dd {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}
