/* ===== 工作室详情页 - 严格对齐设计稿 ===== */
.studio-detail-page {
  min-height: 100vh;
  background: #F5F5F0;
}

.detail-body {
  padding-bottom: 40rpx;
}

/* 封面 */
.cover-box {
  position: relative;
  height: 400rpx;
  margin: 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: linear-gradient(180deg, transparent, rgba(31, 37, 33, 0.55));
}

.cover-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  background: rgba(255, 253, 248, 0.2);
  color: #FFF8E7;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

.cover-name {
  display: block;
  margin-top: 12rpx;
  color: #fff;
  font-size: 42rpx;
  font-family: "STSong", "Noto Serif SC", serif;
  font-weight: 900;
}

/* 信息卡 */
.info-card {
  margin: -20rpx 28rpx 22rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 1rpx solid rgba(123, 158, 122, 0.06);
  position: relative;
  z-index: 2;
}

.info-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-city {
  color: #7E857E;
  font-size: 22rpx;
}

.info-status {
  padding: 6rpx 16rpx;
  background: rgba(123, 158, 122, 0.1);
  color: #5D7261;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

.info-name {
  display: block;
  margin-top: 14rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #333;
}

.info-intro,
.info-owner {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
}

.info-owner {
  color: #5D7261;
  font-weight: 700;
}

.info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #F7F4EF;
  color: #B49658;
  font-size: 18rpx;
  font-weight: 600;
}

/* 详情行 */
.detail-rows {
  margin: 0 28rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  background: rgba(255, 253, 248, 0.85);
  border-radius: 20rpx;
  border: 1rpx solid rgba(173, 140, 88, 0.08);
  margin-bottom: 12rpx;
}

.row-icon {
  width: 44rpx;
  text-align: center;
  font-size: 26rpx;
  flex-shrink: 0;
}

.row-label {
  width: 120rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #333;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.row-value {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #7E857E;
}

/* CTA按钮 */
.cta-btn {
  width: calc(100% - 56rpx);
  height: 88rpx;
  margin: 28rpx 28rpx 0;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #33453A, #6F846F);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 24rpx;
}

.cta-btn:active { opacity: 0.9; }

.error-tip {
  margin: 40rpx 28rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #c84a4a;
  background: #fef2f2;
  border-radius: 16rpx;
}
