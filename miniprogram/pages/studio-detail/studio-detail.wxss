/* ===== Studio Detail Page ===== */
.studio-detail-page {
  padding-top: 0;
}

/* Cover */
.cover-section {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(31, 37, 33, 0.45) 100%);
}

.cover-badge-row {
  display: flex;
  gap: 12rpx;
}

.cover-status {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* Info Card */
.info-card {
  margin: -40rpx 28rpx 24rpx;
  padding: 32rpx;
  position: relative;
  z-index: 5;
}

.info-name {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--brand-ink);
}

.info-location {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--brand-muted);
}

/* Lead Teacher */
.lead-teacher {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  background: var(--brand-green-light);
  border-radius: 16rpx;
}

.lead-avatar-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--brand-green);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lead-icon {
  font-size: 28rpx;
}

.lead-info {
  display: flex;
  flex-direction: column;
}

.lead-label {
  font-size: 20rpx;
  color: var(--brand-muted);
}

.lead-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-ink);
}

/* Tags */
.info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.info-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--brand-gold-light);
  color: var(--brand-gold);
  font-size: 22rpx;
  font-weight: 600;
}

/* Info Grid */
.info-grid {
  padding: 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grid-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.grid-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.grid-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.grid-label {
  font-size: 22rpx;
  color: var(--brand-muted);
  font-weight: 600;
}

.grid-value {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-ink);
}

/* CTA */
.cta-section {
  padding: 36rpx 28rpx 0;
}

/* Loading & Error */
.loading-wrap {
  padding: 120rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: var(--brand-muted);
}

.error-wrap {
  padding: 60rpx 28rpx;
  text-align: center;
}
