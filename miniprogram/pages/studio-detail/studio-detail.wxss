/* ===== Studio Detail Page ===== */
.studio-detail-page {
  padding-top: 0;
}

/* Cover */
.cover-section {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.cover-swiper {
  width: 100%;
  height: 100%;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(31, 37, 33, 0.45) 100%);
}

.cover-badge-row {
  display: flex;
  gap: 12rpx;
}

.cover-status {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* Info Card */
.info-card {
  margin: -40rpx 28rpx 24rpx;
  padding: 32rpx;
  position: relative;
  z-index: 5;
}

.info-name {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--color-text);
}

.info-location {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

/* Lead Teacher */
.lead-teacher {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius-base);
}

.lead-teacher + .lead-teacher {
  margin-top: 12rpx;
}

.lead-avatar-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lead-icon {
  font-size: 28rpx;
}

.lead-info {
  display: flex;
  flex-direction: column;
}

.lead-label {
  font-size: 20rpx;
  color: var(--color-muted);
}

.lead-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
}

.lead-real-name {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* Tags */
.info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.info-tag {
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-gold-light);
  color: var(--color-gold);
  font-size: 22rpx;
  font-weight: 600;
}

/* Info Grid */
.info-grid {
  padding: 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grid-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.grid-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.grid-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.grid-label {
  font-size: 22rpx;
  color: var(--color-muted);
  font-weight: 600;
}

.grid-value {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
}

/* 咨询服务（与「我的认证」页的菜单行保持一致） */
.menu-list {
  margin: 16rpx 28rpx 0;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-card);
  box-shadow: var(--shadow-card);
}

.menu-item {
  width: 100%;
  min-width: 100%;
  max-width: none;
  min-height: 112rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--color-line);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  transform: scale(0.98);
  opacity: 0.84;
}

.menu-item-left {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-base);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-size: 24rpx;
  font-weight: 800;
}

.menu-text {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.menu-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
}

.menu-subtitle {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.menu-arrow {
  margin-left: 16rpx;
  color: var(--color-muted);
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
}

/* Loading & Error */
.loading-wrap {
  padding: 120rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: var(--color-muted);
}

.error-wrap {
  padding: 60rpx 28rpx;
  text-align: center;
}
