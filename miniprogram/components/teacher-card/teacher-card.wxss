.teacher-card {
  display: grid;
  grid-template-columns: 112rpx 1fr 42rpx;
  gap: 22rpx;
  align-items: start;
  min-height: 164rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(93, 114, 97, 0.07);
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 250, 242, 0.9));
  box-shadow: 0 8rpx 40rpx -4rpx rgba(93, 114, 97, 0.10);
  transition: all 0.3s ease;
}

.teacher-card:active {
  transform: scale(0.985);
  box-shadow: 0 4rpx 20rpx -2rpx rgba(93, 114, 97, 0.12);
}

.teacher-card__avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
}

.teacher-card__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(93, 114, 97, 0.12);
  box-shadow: 0 8rpx 18rpx rgba(31, 37, 33, 0.08);
}

.teacher-card__online {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #10b981;
  border: 4rpx solid #fff;
}

.teacher-card__body {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.teacher-card__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.teacher-card__name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.teacher-card__level {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: var(--brand-gold-light);
  color: var(--brand-gold);
  border: 1rpx solid rgba(187, 161, 120, 0.15);
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
}

.teacher-card__check {
  font-size: 16rpx;
}

.teacher-card__cert-no,
.teacher-card__validity {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.teacher-card__arrow {
  align-self: center;
  color: #d1d5db;
  font-size: 44rpx;
  transition: all 0.3s ease;
}

.teacher-card:active .teacher-card__arrow {
  color: var(--brand-green);
  transform: translateX(4rpx);
}
