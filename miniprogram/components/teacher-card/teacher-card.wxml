<view class="teacher-card" bindtap="onTap">
  <view class="teacher-card__avatar-wrap">
    <image
      wx:if="{{teacher.avatarUrl}}"
      class="teacher-card__avatar"
      src="{{teacher.avatarUrl}}"
      mode="aspectFill"
    />
    <view wx:else class="teacher-card__avatar teacher-card__avatar--placeholder">
      <text class="teacher-card__avatar-initial">{{teacher.name[0] || '?'}}</text>
    </view>
    <view class="teacher-card__online" wx:if="{{teacher.certificationStatus === '认证有效'}}"></view>
  </view>

  <view class="teacher-card__body">
    <view class="teacher-card__title-row">
      <text class="teacher-card__name">{{displayName}}</text>
      <view class="teacher-card__badge" wx:if="{{teacher.tierName}}">
        <text class="teacher-card__badge-icon">✓</text>
        <text class="teacher-card__badge-text">{{teacher.tier}} {{teacher.tierName}}</text>
      </view>
    </view>
    <view class="teacher-card__meta-row">
      <text class="teacher-card__cert-no">{{teacher.teacherNo || '—'}}</text>
      <text class="teacher-card__location">{{location || '—'}}</text>
    </view>
  </view>

  <view class="teacher-card__arrow">
    <text class="teacher-card__arrow-icon">›</text>
  </view>
</view>
