.section-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-card__header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-card__title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
  flex: 1;
}

.section-card__extra {
  color: var(--color-gold);
  font-size: 22rpx;
  font-weight: 600;
}

.section-card__body {
  width: 100%;
}
