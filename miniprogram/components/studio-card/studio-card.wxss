.studio-card {
  display: grid;
  grid-template-columns: 144rpx 1fr;
  gap: 24rpx;
  align-items: stretch;
  padding: 24rpx;
  border: 1rpx solid rgba(93, 114, 97, 0.07);
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 250, 242, 0.9));
  box-shadow: 0 8rpx 40rpx -4rpx rgba(93, 114, 97, 0.10);
  transition: all 0.3s ease;
}

.studio-card:active {
  transform: scale(0.985);
  box-shadow: 0 4rpx 20rpx -2rpx rgba(93, 114, 97, 0.12);
}

.studio-card__cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(93, 114, 97, 0.08);
  box-shadow: 0 6rpx 16rpx rgba(31, 37, 33, 0.08);
}

.studio-card__body {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.studio-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.studio-card__name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.studio-card__rating {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(187, 161, 120, 0.15);
  color: var(--brand-gold);
  font-size: 20rpx;
  font-weight: 800;
}

.studio-card__star {
  color: #f59e0b;
}

.studio-card__loc {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
}

.studio-card__pin {
  color: var(--brand-green);
  font-size: 24rpx;
}

.studio-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.studio-card__tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f8faf9;
  border: 1rpx solid #f0f2f1;
  color: #9ca3af;
  font-size: 18rpx;
}

.studio-card__cta {
  grid-column: 2;
  align-self: end;
  justify-self: end;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  background: var(--brand-green-light);
  color: var(--brand-green);
  font-size: 20rpx;
  font-weight: 800;
  transition: all 0.2s ease;
}

.studio-card:active .studio-card__cta {
  background: var(--brand-green-lighter);
}
