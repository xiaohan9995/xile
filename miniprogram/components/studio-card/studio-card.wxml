<view class="studio-card" bindtap="onTap">
  <image
    wx:if="{{coverImage}}"
    class="studio-card__cover"
    src="{{coverImage}}"
    mode="aspectFill"
  />
  <view wx:else class="studio-card__cover studio-card__cover--placeholder">
    <text class="studio-card__cover-initial">{{coverInitial}}</text>
  </view>

  <view class="studio-card__body">
    <text class="studio-card__name">{{studio.name}}</text>

    <view class="studio-card__location">
      <text class="studio-card__address">{{studio.city}} · {{studio.district}}</text>
    </view>

    <view class="studio-card__tags" wx:if="{{displayTags.length}}">
      <text
        wx:for="{{displayTags}}"
        wx:key="*this"
        class="studio-card__tag"
      >{{item}}</text>
    </view>
  </view>
</view>
