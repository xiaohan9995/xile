<view class="empty-state">
  <view class="empty-state__icon-wrap">
    <text class="empty-state__icon">{{icon || '&#x1F4ED;'}}</text>
  </view>
  <text class="empty-state__message">{{message}}</text>
  <view
    class="empty-state__btn"
    wx:if="{{actionText}}"
    bindtap="onAction"
    hover-class="empty-state__btn--hover"
  >
    <text class="empty-state__btn-text">{{actionText}}</text>
  </view>
</view>
