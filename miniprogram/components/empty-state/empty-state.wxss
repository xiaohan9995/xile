.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-state__icon {
  font-size: 80rpx;
  opacity: 0.5;
  margin-bottom: 20rpx;
}

.empty-state__msg {
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-state__action {
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--brand-green-light);
  color: var(--brand-green);
  font-size: 24rpx;
  font-weight: 700;
}
