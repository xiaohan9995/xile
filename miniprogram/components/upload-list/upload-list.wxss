.upload-list {
  display: grid;
  gap: 18rpx;
}

.upload-tile {
  min-height: 118rpx;
  padding: 20rpx;
  display: grid;
  grid-template-columns: 96rpx 1fr;
  gap: 22rpx;
  align-items: center;
  border: 1rpx dashed var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  transition: background 0.2s ease, border-color 0.2s ease;
}

.upload-tile:active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.upload-tile--done {
  border-style: solid;
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.upload-tile__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  font-size: 34rpx;
}

.upload-tile__check {
  color: var(--color-primary);
  font-size: 38rpx;
  font-weight: 900;
}

.upload-tile__upload {
  color: var(--color-muted);
}

.upload-tile__body {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.upload-tile__title {
  display: block;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}

.upload-tile__desc {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
