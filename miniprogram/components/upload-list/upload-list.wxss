.upload-list {
  display: grid;
  gap: 18rpx;
}

.upload-tile {
  min-height: 118rpx;
  padding: 20rpx;
  display: grid;
  grid-template-columns: 96rpx 1fr;
  gap: 22rpx;
  align-items: center;
  border: 1rpx dashed #d7dce0;
  border-radius: 28rpx;
  background: rgba(248, 250, 252, 0.68);
  transition: all 0.25s ease;
}

.upload-tile:active {
  background: rgba(240, 243, 241, 0.8);
  border-color: var(--color-primary);
}

.upload-tile--done {
  border-style: solid;
  border-color: rgba(16, 185, 129, 0.3);
  background: rgba(220, 252, 231, 0.3);
}

.upload-tile__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(31, 37, 33, 0.04);
  font-size: 34rpx;
}

.upload-tile__check {
  color: #10b981;
  font-size: 38rpx;
  font-weight: 900;
}

.upload-tile__upload {
  color: var(--color-muted);
}

.upload-tile__body {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.upload-tile__title {
  display: block;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}

.upload-tile__desc {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
