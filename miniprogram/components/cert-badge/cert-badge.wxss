.cert-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-gold-light);
  border: 1rpx solid rgba(184, 154, 99, 0.15);
}

.cert-badge__icon {
  font-size: 22rpx;
  line-height: 1;
}

.cert-badge__text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-gold);
  white-space: nowrap;
}
