.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #ffffff;
  border-top: 1rpx solid rgba(31, 37, 33, 0.08);
  z-index: 999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  color: #7e857e;
  font-size: 20rpx;
  font-weight: 600;
}

.tab-item.active {
  color: #5f7365;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}
