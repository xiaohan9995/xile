.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #ffffff;
  border-top: 1rpx solid rgba(31, 37, 33, 0.08);
  z-index: 999;
}

.tab-item {
  position: relative;
  flex: 1;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 0;
  padding: 8rpx 0;
  box-sizing: border-box;
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 600;
  transition: background-color 160ms ease, color 160ms ease;
}

.tab-item.active {
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  margin: 10rpx 14rpx;
  border-radius: 22rpx;
  box-shadow: inset 0 0 0 1rpx rgba(66, 109, 88, 0.08);
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
}
