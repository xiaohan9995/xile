/* ============================================
   喜乐瑜伽 · 底部导航栏
   Bottom tab bar + unified inline SVG icons
   ============================================ */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding: 0 16rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  background: #ffffff;
  border-top: 1rpx solid rgba(31, 37, 33, 0.06);
  box-shadow: 0 -6rpx 24rpx rgba(32, 57, 42, 0.06);
  z-index: 999;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 0;
  margin: 8rpx 6rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
  border-radius: 20rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.5rpx;
  transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
}

/* 按压反馈 */
.tab-item--hover {
  transform: scale(0.94);
  opacity: 0.82;
}

.tab-item.active {
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
}

.tab-label {
  font-size: 20rpx;
  line-height: 1;
}

.tab-item.active .tab-label {
  font-weight: 700;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item.active .tab-icon {
  transform: translateY(-2rpx) scale(1.06);
}

/* Icons · 未选中（线性描边 / 静音色） */
.tab-icon--home { background-image: url("data:image/svg+xml;base64,"); }
.tab-icon--teacher { background-image: url("data:image/svg+xml;base64,"); }
.tab-icon--studio { background-image: url("data:image/svg+xml;base64,"); }
.tab-icon--my { background-image: url("data:image/svg+xml;base64,"); }

/* Icons · 选中（线性描边 / 品牌主色） */
.tab-item.active .tab-icon--home { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon--teacher { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon--studio { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon--my { background-image: url("data:image/svg+xml;base64,"); }
