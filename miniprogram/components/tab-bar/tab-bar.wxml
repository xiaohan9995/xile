<view class="tab-bar">
  <view
    class="tab-item {{active === 'home' ? 'active' : ''}}"
    aria-role="button"
    aria-label="首页"
    hover-class="tab-item--hover"
    hover-start-time="0"
    hover-stay-time="120"
    bindtap="goHome"
  >
    <view class="tab-icon tab-icon--home"></view>
    <text class="tab-label">首页</text>
  </view>
  <view
    class="tab-item {{active === 'teacher' ? 'active' : ''}}"
    aria-role="button"
    aria-label="师资"
    hover-class="tab-item--hover"
    hover-start-time="0"
    hover-stay-time="120"
    bindtap="goTeacher"
  >
    <view class="tab-icon tab-icon--teacher"></view>
    <text class="tab-label">师资</text>
  </view>
  <view
    class="tab-item {{active === 'studio' ? 'active' : ''}}"
    aria-role="button"
    aria-label="工作室"
    hover-class="tab-item--hover"
    hover-start-time="0"
    hover-stay-time="120"
    bindtap="goStudio"
  >
    <view class="tab-icon tab-icon--studio"></view>
    <text class="tab-label">工作室</text>
  </view>
  <view
    class="tab-item {{active === 'my' ? 'active' : ''}}"
    aria-role="button"
    aria-label="我的"
    hover-class="tab-item--hover"
    hover-start-time="0"
    hover-stay-time="120"
    bindtap="goMy"
  >
    <view class="tab-icon tab-icon--my"></view>
    <text class="tab-label">我的</text>
  </view>
</view>
