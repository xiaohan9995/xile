/* ============================================
   喜乐瑜伽 · 全局设计系统
   Design tokens + utility classes
   ============================================ */

page {
  --color-primary: #426d58;
  --color-primary-dark: #2f5140;
  --color-primary-light: #edf5ef;
  --color-brand: #426d58;
  --color-bg: #f5f7f4;
  --color-gold: #89652b;
  --color-gold-light: #faf4e8;
  --color-text: #1c2a22;
  --color-muted: #606b64;
  --color-surface: #e8ede9;
  --color-card: #ffffff;
  --color-line: #dce4de;
  --color-border: #bbc8bf;
  --color-success: #1f8a4c;
  --color-danger: #fa5151;
  --radius-sm: 8rpx;
  --radius-base: 16rpx;
  --radius-md: 24rpx;
  --radius-xl: 28rpx;
  --radius-lg: 32rpx;
  --radius-full: 999rpx;
  --shadow-card: 0 8rpx 24rpx rgba(32, 57, 42, 0.06);
  --shadow-elevated: 0 16rpx 40rpx rgba(32, 57, 42, 0.1);
  font-family: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.6;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ============================================
   Reset
   ============================================ */

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: normal;
  background: transparent;
  color: inherit;
  font: inherit;
}

button::after {
  border: 0;
}

image {
  display: block;
}

/* ============================================
   Utility classes
   ============================================ */

.page-shell {
  min-height: 100vh;
  padding: 0 0 env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gap-sm {
  gap: 12rpx;
}

.gap-md {
  gap: 24rpx;
}

.p-page {
  padding: 0 32rpx;
}

.mt-sm {
  margin-top: 16rpx;
}

.mt-md {
  margin-top: 24rpx;
}

.mt-lg {
  margin-top: 40rpx;
}

.text-center {
  text-align: center;
}

.text-muted {
  color: var(--color-muted);
}

.font-bold {
  font-weight: 700;
}

/* ============================================
   Card surface
   ============================================ */

.card {
  background: var(--color-card);
  border-radius: var(--radius-base);
  border: 1rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
}

.section-eyebrow {
  color: var(--color-gold);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.section-title {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text);
  font-family: inherit;
  font-size: 36rpx;
  font-weight: 700;
}

.section-link { color: var(--color-primary-dark); font-size: 24rpx; font-weight: 700; }

.soft-card {
  background: var(--color-card);
  border-radius: var(--radius-base);
  border: 1rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
}

/* ============================================
   Page header (custom nav)
   ============================================ */

.page-header {
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-bottom: 1rpx solid var(--color-line);
  position: relative;
  z-index: 20;
  box-sizing: border-box;
  min-height: 88rpx;
}

.page-header::after { display: none; }

.page-header__back {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: var(--color-text);
  line-height: normal;
}

.page-header__back:active {
  background: rgba(31, 37, 33, 0.08);
}

.page-header__title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1rpx;
}

.page-header__right {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 34rpx;
}

.page-header__home {
  color: var(--color-primary-dark);
  font-size: 24rpx;
  font-weight: 700;
}

.page-header__home:active {
  opacity: 0.58;
}

/* ============================================
   Buttons
   ============================================ */

.btn-primary {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-base);
  color: #fff;
  background: var(--color-primary);
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.btn-primary:active {
  background: var(--color-primary-dark);
  transform: scale(0.98);
}

.btn-ghost {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-base);
  color: var(--color-primary);
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, background 0.2s ease;
}

.btn-ghost:active {
  background: var(--color-surface);
  transform: scale(0.98);
}

/* ============================================
   Badges
   ============================================ */

.badge-gold {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-gold-light);
  color: var(--color-gold);
  border: 1rpx solid rgba(187, 161, 120, 0.18);
  font-size: 22rpx;
  font-weight: 700;
}

.badge-green {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
  color: var(--color-primary);
  border: 1rpx solid rgba(93, 114, 97, 0.12);
  font-size: 22rpx;
  font-weight: 700;
}

/* ============================================
   Animations
   ============================================ */

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleUp {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

.animate-fade-in {
  animation: fadeIn 0.5s ease both;
}

.animate-fade-in-up {
  animation: fadeInUp 0.5s ease both;
}

.animate-scale-up {
  animation: scaleUp 0.3s ease both;
}

/* ============================================
   Error / Empty states
   ============================================ */

.error-tip {
  margin: 24rpx 32rpx 0;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-danger);
  background: #fef2f2;
  border-radius: var(--radius-md);
}

.empty-state {
  margin-top: 80rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-muted);
}

/* ============================================
   Load More
   ============================================ */

.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--color-muted);
}

/* ============================================
   Skeleton Loading
   ============================================ */

@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 800rpx 100%;
  animation: shimmer 1.5s infinite linear;
  border-radius: var(--radius-sm);
}

.skeleton-circle {
  border-radius: 50%;
}

.skeleton-card {
  padding: 24rpx;
  margin: 16rpx 32rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
}

.skeleton-row {
  height: 28rpx;
  margin-bottom: 16rpx;
}

.skeleton-row--short {
  width: 40%;
}

.skeleton-row--medium {
  width: 65%;
}

.skeleton-row--long {
  width: 90%;
}
