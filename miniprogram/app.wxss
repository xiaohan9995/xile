/* ============================================
   喜乐瑜伽 · 全局设计系统
   Design tokens + utility classes
   ============================================ */

page {
  --color-primary: #78887A;
  --color-primary-dark: #5d6856;
  --color-bg: #F7F4EE;
  --color-gold: #B89A63;
  --color-gold-light: rgba(184, 154, 99, 0.12);
  --color-text: #1F2521;
  --color-muted: #8a938b;
  --color-surface: #E8ECE9;
  --color-card: #ffffff;
  --color-line: rgba(120, 136, 122, 0.10);
  --color-danger: #c84a4a;
  --radius-sm: 12rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-full: 999rpx;
  --shadow-card: 0 8rpx 40rpx -4rpx rgba(93, 114, 97, 0.10);
  --shadow-elevated: 0 14rpx 28rpx rgba(93, 114, 97, 0.18);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.6;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ============================================
   Reset
   ============================================ */

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: normal;
  background: transparent;
  color: inherit;
  font: inherit;
}

button::after {
  border: 0;
}

image {
  display: block;
}

/* ============================================
   Utility classes
   ============================================ */

.page-shell {
  min-height: 100vh;
  padding: 0 0 env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gap-sm {
  gap: 12rpx;
}

.gap-md {
  gap: 24rpx;
}

.p-page {
  padding: 0 32rpx;
}

.mt-sm {
  margin-top: 16rpx;
}

.mt-md {
  margin-top: 24rpx;
}

.mt-lg {
  margin-top: 40rpx;
}

.text-center {
  text-align: center;
}

.text-muted {
  color: var(--color-muted);
}

.font-bold {
  font-weight: 700;
}

/* ============================================
   Card surface
   ============================================ */

.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
}

/* ============================================
   Page header (custom nav)
   ============================================ */

.page-header {
  padding: 0 28rpx;
  display: grid;
  grid-template-columns: 64rpx 1fr 64rpx;
  align-items: center;
  background: rgba(247, 244, 238, 0.96);
  border-bottom: 1rpx solid var(--color-line);
  position: sticky;
  top: 0;
  z-index: 20;
  box-sizing: border-box;
  min-height: 44px;
}

.page-header__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: var(--color-text);
  line-height: 1;
}

.page-header__back:active {
  background: rgba(120, 136, 122, 0.08);
}

.page-header__title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1rpx;
}

.page-header__right {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 34rpx;
}

/* ============================================
   Buttons
   ============================================ */

.btn-primary {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-full);
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-card);
}

.btn-ghost {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-full);
  color: var(--color-primary);
  background: var(--color-card);
  border: 2rpx solid var(--color-surface);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-ghost:active {
  background: var(--color-surface);
  transform: scale(0.97);
}

/* ============================================
   Badges
   ============================================ */

.badge-gold {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-gold-light);
  color: var(--color-gold);
  border: 1rpx solid rgba(184, 154, 99, 0.2);
  font-size: 22rpx;
  font-weight: 700;
}

.badge-green {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(120, 136, 122, 0.1);
  color: var(--color-primary);
  border: 1rpx solid rgba(120, 136, 122, 0.15);
  font-size: 22rpx;
  font-weight: 700;
}

/* ============================================
   Animations
   ============================================ */

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleUp {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

.animate-fade-in {
  animation: fadeIn 0.5s ease both;
}

.animate-fade-in-up {
  animation: fadeInUp 0.5s ease both;
}

.animate-scale-up {
  animation: scaleUp 0.3s ease both;
}

/* ============================================
   Error / Empty states
   ============================================ */

.error-tip {
  margin: 24rpx 32rpx 0;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-danger);
  background: #fef2f2;
  border-radius: var(--radius-md);
}

.empty-state {
  margin-top: 80rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-muted);
}
