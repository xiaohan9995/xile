.cert-step-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: #faf8f5;
}

.query-header {
  height: 96rpx;
  padding: 0 28rpx;
  display: grid;
  grid-template-columns: 64rpx 1fr 64rpx;
  align-items: center;
  background: #fff;
  border-bottom: 1rpx solid #f0f2f1;
}

.query-header button {
  font-size: 42rpx;
  color: #374151;
}

.query-header text:nth-child(2) {
  text-align: center;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 800;
}

.step-strip {
  padding: 28rpx;
  display: grid;
  grid-template-columns: auto 1fr auto 1fr auto;
  align-items: center;
  background: #fffbf0;
  border-bottom: 1rpx solid #f7eacd;
}

.step {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 800;
}

.step-dot {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 50%;
  text-align: center;
  background: #e5e7eb;
  color: #fff;
  font-size: 20rpx;
}

.step.active {
  color: #f97316;
}

.step.active .step-dot {
  color: #fff;
  background: #f97316;
  box-shadow: 0 0 0 8rpx rgba(249, 115, 22, 0.15);
}

.line {
  height: 2rpx;
  margin: 0 12rpx;
  background: #e5e7eb;
}

.form-panel {
  margin: 28rpx;
  padding: 30rpx;
  border: 1rpx solid #f0f2f1;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(93, 114, 97, 0.08);
}

.form-title text:first-child {
  display: block;
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 900;
}

.form-title text:last-child {
  display: block;
  margin-top: 6rpx;
  color: #8a938b;
  font-size: 22rpx;
}

.field {
  margin-top: 28rpx;
}

.field text {
  display: block;
  margin-bottom: 12rpx;
  color: #39423c;
  font-size: 24rpx;
  font-weight: 800;
}

.required {
  display: inline;
  color: #ef4444;
  font-family: "JetBrains Mono", monospace;
  margin-left: 4rpx;
}

.field input {
  height: 82rpx;
  padding: 0 4rpx;
  border: 0;
  border-bottom: 1rpx solid #e7ebe8;
  border-radius: 0;
  background: transparent;
  color: #1f2937;
  font-size: 26rpx;
  transition: border-color 0.3s ease;
}

.field input:focus {
  border-bottom-color: #5d7261;
}

.form-error {
  margin-top: 20rpx;
  color: #b54c4c;
  font-size: 24rpx;
}

.action-row.single {
  display: block;
  padding: 0 28rpx;
}

.submit {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #5d7261;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx rgba(93, 114, 97, 0.24);
}
