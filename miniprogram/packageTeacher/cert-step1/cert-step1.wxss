/* ===== Cert Step 1 (认证申请 Step1) ===== */
@import '../common/progress-strip.wxss';

.cert-step-page {
  padding-top: 0;
}

/* Form Card */
.form-card {
  margin: 28rpx;
  padding: 36rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
}

.form-header {
  margin-bottom: 28rpx;
}

.form-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--color-text);
}

.form-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* Fields */
.form-field {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--color-text);
}

.field-required {
  color: var(--color-danger);
  font-family: "JetBrains Mono", monospace;
}

.field-input {
  height: 80rpx;
  padding: 0 4rpx;
  border: 0;
  border-bottom: 2rpx solid var(--color-line);
  background: transparent;
  color: var(--color-text);
  font-size: 28rpx;
  transition: border-color 0.2s ease;
}

.field-input:focus {
  border-bottom-color: var(--color-primary);
}

/* Picker */
.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 4rpx;
  border-bottom: 2rpx solid var(--color-line);
  font-size: 28rpx;
  color: var(--color-text);
}

.field-picker--placeholder {
  color: #b0b8b1;
}

.picker-arrow {
  font-size: 24rpx;
  color: var(--color-muted);
}

/* Error */
.form-error {
  margin-top: 20rpx;
  padding: 12rpx 16rpx;
  background: #fef2f2;
  border-radius: 12rpx;
  border: 1rpx solid #fecaca;
}

.form-error text {
  font-size: 24rpx;
  color: #c84a4a;
}

/* Action */
.action-section {
  padding: 16rpx 28rpx;
}
