<view class="cert-step-page">
  <view class="query-header">
    <button bindtap="goBack">‹</button>
    <text>认证申请</text>
    <text></text>
  </view>

  <view class="step-strip">
    <view class="step active"><text class="step-dot">1</text><text class="step-label">个人信息</text></view>
    <view class="line"></view>
    <view class="step"><text class="step-dot">2</text><text class="step-label">资料上传</text></view>
    <view class="line"></view>
    <view class="step"><text class="step-dot">3</text><text class="step-label">审核中</text></view>
  </view>

  <view class="form-panel">
    <view class="form-title">
      <text>导师认证基础资料</text>
      <text>请保持与证件及培训证明一致</text>
    </view>

    <view class="field">
      <text>姓名 <text class="required">*</text></text>
      <input value="{{form.name}}" data-field="name" bindinput="onFieldInput" placeholder="请输入真实姓名" />
    </view>

    <view class="field">
      <text>身份证合规代码 <text class="required">*</text></text>
      <input value="{{form.idNumber}}" data-field="idNumber" bindinput="onFieldInput" placeholder="请输入18位身份证号 / 认证证件号" />
    </view>

    <view class="field">
      <text>瑜伽专用流派 <text class="required">*</text></text>
      <input value="{{form.specialization}}" data-field="specialization" bindinput="onFieldInput" placeholder="如：流瑜伽 / 哈他瑜伽 / 理疗瑜伽" />
    </view>

    <view wx:if="{{error}}" class="form-error">{{error}}</view>
  </view>

  <view class="action-row single">
    <button class="submit" bindtap="goNext">下一步</button>
  </view>
</view>
