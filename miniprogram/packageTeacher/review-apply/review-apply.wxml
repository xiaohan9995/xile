<view class="apply-page">
  <view class="query-header">
    <button bindtap="goBack">‹</button>
    <text>上传证明材料</text>
    <text></text>
  </view>

  <view class="step-strip">
    <view class="step done"><text class="step-dot">✓</text><text class="step-label">个人信息</text></view>
    <view class="line done"></view>
    <view class="step active"><text class="step-dot">2</text><text class="step-label">资料上传</text></view>
    <view class="line"></view>
    <view class="step"><text class="step-dot">3</text><text class="step-label">审核中</text></view>
  </view>

  <view class="upload-panel">
    <view wx:for="{{files}}" wx:key="title" class="upload-tile" bindtap="chooseFile" data-index="{{index}}">
      <view class="upload-icon">{{item.done ? '✓' : '⇧'}}</view>
      <view>
        <text class="upload-title">{{item.title}}</text>
        <text class="upload-desc">{{item.fileName || item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="action-row">
    <button class="secondary" bindtap="goBack">上一步</button>
    <button class="submit" bindtap="submitReview" loading="{{submitting}}" disabled="{{submitting}}">提交审核</button>
  </view>
</view>
