/* ===== Review Apply Page (材料上传 Step2) ===== */
.apply-page {
  padding-top: 0;
}

/* Progress Strip */
.progress-strip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 40rpx;
  background: var(--brand-gold-light);
  border-bottom: 1rpx solid rgba(180, 150, 88, 0.12);
}

.step-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 50%;
  text-align: center;
  background: #e5e7eb;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.step-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand-muted);
}

.step-item--active .step-dot {
  background: var(--brand-green);
  box-shadow: 0 0 0 6rpx rgba(123, 158, 122, 0.2);
}

.step-item--active .step-label {
  color: var(--brand-green);
}

.step-item--done .step-dot {
  background: var(--brand-gold);
}

.step-item--done .step-label {
  color: var(--brand-gold);
}

.step-line {
  width: 60rpx;
  height: 2rpx;
  margin: 0 14rpx;
  background: #e5e7eb;
}

.step-line--done {
  background: var(--brand-gold);
}

/* Upload Section */
.upload-section {
  padding: 28rpx;
}

.upload-title-row {
  margin-bottom: 20rpx;
}

.upload-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: var(--brand-ink);
}

.upload-section-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brand-muted);
}

/* Upload Grid */
.upload-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.upload-tile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border: 2rpx dashed var(--brand-green-lighter);
  transition: all 0.2s ease;
}

.upload-tile:active {
  transform: scale(0.98);
}

.upload-tile--done {
  border-style: solid;
  border-color: var(--brand-green);
  background: linear-gradient(180deg, rgba(240, 243, 241, 0.9), rgba(255, 255, 255, 0.94));
}

.upload-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-green-light);
  flex-shrink: 0;
}

.upload-icon {
  font-size: 34rpx;
  color: var(--brand-muted);
}

.upload-tile--done .upload-icon-wrap {
  background: var(--brand-green);
}

.upload-tile--done .upload-icon {
  color: #fff;
}

.upload-text {
  flex: 1;
  min-width: 0;
}

.upload-name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--brand-ink);
}

.upload-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brand-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Actions */
.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 16rpx 28rpx;
}

.action-row .btn-ghost {
  height: 84rpx;
  font-size: 26rpx;
}

.action-row .btn-primary {
  height: 84rpx;
  font-size: 26rpx;
}
