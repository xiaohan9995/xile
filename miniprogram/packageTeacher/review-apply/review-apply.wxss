/* ===== Review Apply Page (材料上传 Step2) ===== */
.apply-page {
  padding-top: 0;
}

@import '../common/progress-strip.wxss';

/* Upload Section */
.upload-section {
  padding: 28rpx;
}

.upload-title-row {
  margin-bottom: 20rpx;
}

.upload-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-text);
}

.upload-section-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* Upload Grid */
.upload-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.upload-tile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border: 2rpx dashed var(--color-line);
  transition: all 0.2s ease;
}

.upload-tile:active {
  transform: scale(0.98);
}

.upload-tile--done {
  border-style: solid;
  border-color: var(--color-primary);
  background: linear-gradient(180deg, rgba(240, 243, 241, 0.9), rgba(255, 255, 255, 0.94));
}

.upload-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-light);
  flex-shrink: 0;
}

.upload-icon {
  font-size: 34rpx;
  color: var(--color-muted);
}

.upload-tile--done .upload-icon-wrap {
  background: var(--color-primary);
}

.upload-tile--done .upload-icon {
  color: #fff;
}

.upload-text {
  flex: 1;
  min-width: 0;
}

.upload-name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
}

.upload-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Actions */
.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 16rpx 28rpx;
}

.action-row .btn-ghost {
  height: 84rpx;
  font-size: 26rpx;
}

.action-row .btn-primary {
  height: 84rpx;
  font-size: 26rpx;
}
