.link-page { min-height: 100vh; background: var(--color-bg); }
.link-body { padding: 70rpx 48rpx calc(80rpx + env(safe-area-inset-bottom)); text-align: center; }
.link-icon { width: 112rpx; height: 112rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-lg); background: var(--color-primary-light); color: var(--color-primary-dark); font-size: 52rpx; font-weight: 700; }
.link-title { display: block; margin-top: 30rpx; color: var(--color-text); font-size: 42rpx; font-weight: 800; }
.link-description { display: block; margin-top: 18rpx; color: var(--color-muted); font-size: 26rpx; line-height: 1.75; text-align: left; }
.code-card { margin-top: 48rpx; padding: 32rpx; border: 1rpx solid var(--color-line); border-radius: var(--radius-md); background: var(--color-card); text-align: left; }
.code-label { display: block; color: var(--color-text); font-size: 26rpx; font-weight: 700; }
.code-label--password { margin-top: 24rpx; }
.code-input { width: 100%; height: 88rpx; margin-top: 20rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid var(--color-line); border-radius: var(--radius-base); background: var(--color-surface); color: var(--color-text); font-family: monospace; font-size: 28rpx; font-weight: 700; letter-spacing: 3rpx; text-align: left; transition: border-color 0.2s ease; }
.code-input:focus { border-color: var(--color-primary); }
.code-placeholder { color: var(--color-muted); font-size: 25rpx; font-weight: 400; letter-spacing: 1rpx; }
.code-input--password { font-family: inherit; font-weight: 400; letter-spacing: 0; }
.code-note { display: block; margin-top: 16rpx; color: var(--color-muted); font-size: 21rpx; line-height: 1.55; }
.code-card .btn-primary { margin-top: 32rpx; }
.support-row { display: flex; justify-content: center; gap: 8rpx; margin-top: 34rpx; color: var(--color-muted); font-size: 23rpx; }
.support-link { color: var(--color-primary-dark); font-weight: 600; }
.support-link:active { opacity: 0.7; }
