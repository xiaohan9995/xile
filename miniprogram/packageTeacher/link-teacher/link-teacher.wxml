<view class="link-page">
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">关联教师身份</text>
    <view class="page-header__right"></view>
  </view>

  <view class="link-body">
    <view class="link-icon">证</view>
    <text class="link-title">关联你的教师档案</text>
    <text class="link-description">请先使用微信登录，再输入教师身份证号和初始密码。关联成功后必须立即重置密码。</text>

    <view class="code-card">
      <text class="code-label">教师身份证号</text>
      <input
        class="code-input"
        value="{{idNumber}}"
        maxlength="32"
        placeholder="请输入身份证号"
        placeholder-class="code-placeholder"
        bindinput="onIdNumberInput"
      />
      <text class="code-label code-label--password">初始密码</text>
      <input class="code-input code-input--password" password value="{{password}}" maxlength="64" placeholder="身份证号后六位" placeholder-class="code-placeholder" bindinput="onPasswordInput" />
      <text class="code-note">每位教师只能关联一个微信账号；关联后必须立即设置新密码。</text>
      <button class="link-button" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">确认关联</button>
    </view>

    <view class="support-row">
      <text class="support-link" bindtap="usePasswordLogin">已有教师账号，直接登录</text>
    </view>
  </view>
</view>
