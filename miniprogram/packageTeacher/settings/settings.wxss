.settings-page {
  min-height: 100vh;
  padding-top: 0;
  background: var(--color-bg);
}

.settings-body {
  padding: 28rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
}

.settings-intro {
  padding: 18rpx 4rpx 30rpx;
}

.settings-intro__eyebrow {
  display: block;
  color: var(--color-gold);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.settings-intro__title {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.settings-intro__description {
  display: block;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}

.section-heading--spaced {
  margin-top: 34rpx;
}

.section-heading__title {
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 700;
}

.section-heading__note {
  margin-left: 24rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  text-align: right;
}

.settings-group {
  overflow: hidden;
  padding: 0 28rpx 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-card);
}

.field-block {
  padding-top: 26rpx;
}

.field-divider {
  height: 1rpx;
  margin-top: 26rpx;
  background: var(--color-line);
}

.field-label {
  display: block;
  margin-bottom: 13rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 600;
}

.settings-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-base);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 27rpx;
}

.action-button {
  width: 100%;
  min-width: 100%;
  max-width: none;
  height: 88rpx;
  margin: 26rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-base);
  font-size: 27rpx;
  font-weight: 700;
}

.action-button--primary {
  background: var(--color-primary);
  color: #fff;
}

.action-button--secondary {
  border: 1rpx solid rgba(66, 109, 88, 0.28);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
}

.action-button:active,
.logout-button:active {
  opacity: 0.82;
}

.logout-area {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--color-line);
  text-align: center;
}

.logout-button {
  width: 100%;
  min-width: 100%;
  max-width: none;
  height: 88rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(200, 75, 69, 0.28);
  border-radius: var(--radius-base);
  background: rgba(200, 75, 69, 0.06);
  color: #c84b45;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.logout-note {
  display: block;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

@media (prefers-color-scheme: dark) {
  .settings-page { background: #172019; }
  .settings-intro__title,
  .section-heading__title,
  .field-label { color: #f1f5f1; }
  .settings-intro__description,
  .section-heading__note,
  .logout-note { color: #b9c5bb; }
  .settings-group { border-color: #405445; background: #202b22; }
  .field-divider { background: #405445; }
  .settings-input { border-color: #405445; background: #18231b; color: #f1f5f1; }
  .action-button--secondary { border-color: #476653; background: #294133; color: #d8eadc; }
  .logout-area { border-color: #405445; }
  .logout-button { border-color: rgba(222, 105, 99, 0.34); background: rgba(200, 75, 69, 0.1); color: #ee8c87; }
}
