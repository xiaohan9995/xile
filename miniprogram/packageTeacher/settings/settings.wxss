/* ===== Settings Page ===== */
.settings-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.settings-body {
  padding: 32rpx;
}

.settings-section {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--color-muted);
  margin-bottom: 20rpx;
  display: block;
}

/* Avatar */
.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.avatar-btn {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: visible;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  display: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-primary-light);
}

.avatar-empty {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx dashed var(--color-border);
}

.avatar-empty-icon {
  font-size: 48rpx;
}

.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.avatar-tip {
  font-size: 22rpx;
  color: var(--color-muted);
}

/* Nickname Input */
.settings-input {
  width: 100%;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--color-surface);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  border: 2rpx solid var(--color-border);
}

/* Phone */
.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.phone-display {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 500;
}

.phone-display.phone-empty {
  color: var(--color-muted);
}

.phone-change-btn {
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 56rpx;
}

.phone-change-btn::after {
  display: none;
}

/* Save Button */
.save-btn {
  width: 100% !important;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
}

.save-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
