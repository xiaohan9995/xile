.settings-page {
  min-height: 100vh;
  padding-top: 0;
  background: var(--color-bg);
}

.settings-body {
  padding: 28rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
}

.settings-intro {
  padding: 18rpx 4rpx 30rpx;
}

.settings-intro__eyebrow {
  display: block;
  color: var(--color-gold);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.settings-intro__title {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.settings-intro__description {
  display: block;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.settings-group--guest {
  padding-top: 28rpx;
}

.guest-note__title {
  display: block;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.guest-note__detail {
  display: block;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

/* ===== Avatar ===== */
.settings-group--avatar {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.avatar-editor {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  flex-shrink: 0;
  overflow: visible;
}

.avatar-editor:active {
  opacity: 0.82;
  transform: scale(0.96);
}

.avatar-img {
  width: 112rpx;
  height: 112rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--color-surface);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.avatar-img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #d8e5da;
}

.avatar-initial {
  color: var(--color-primary-dark);
  font-size: 48rpx;
  font-weight: 800;
}

.avatar-badge {
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--color-card);
  border-radius: 50%;
  background: var(--color-primary-dark);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}

.avatar-row__info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.avatar-row__title {
  display: block;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
}

.avatar-row__note {
  display: block;
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  padding: 0 4rpx 14rpx;
}

.section-heading--spaced {
  margin-top: 34rpx;
}

.section-heading__title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.section-heading__note {
  color: var(--color-muted);
  font-size: 21rpx;
  text-align: right;
}

.settings-group {
  overflow: hidden;
  padding: 0 28rpx 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-card);
}

.field-block {
  padding-top: 26rpx;
}

.field-divider {
  height: 1rpx;
  margin-top: 26rpx;
  background: var(--color-line);
}

.field-label {
  display: block;
  margin-bottom: 13rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 600;
}

.settings-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-base);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  transition: border-color 0.2s ease;
}

.settings-input:focus {
  border-color: var(--color-primary);
}

.settings-picker { display:flex; align-items:center; }
.settings-textarea { height:160rpx; padding-top:20rpx; }
.visibility-list { margin-top:26rpx; border-top:1rpx solid var(--color-line); }
.visibility-row { min-height:82rpx; display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid var(--color-line); color:var(--color-text); font-size:24rpx; }

.settings-group .btn-primary,
.settings-group .btn-secondary {
  margin-top: 26rpx;
}

.settings-group .btn-primary:active,
.settings-group .btn-secondary:active {
  opacity: 0.82;
}

.logout-button:active {
  opacity: 0.82;
}

.logout-area {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--color-line);
  text-align: center;
}

.logout-button {
  width: 100%;
  min-width: 100%;
  max-width: none;
  height: 96rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(200, 75, 69, 0.28);
  border-radius: var(--radius-base);
  background: rgba(200, 75, 69, 0.06);
  color: #c84b45;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.logout-note {
  display: block;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

@media (prefers-color-scheme: dark) {
  .settings-page { background: #172019; }
  .settings-intro__title,
  .section-heading__title,
  .field-label,
  .guest-note__title { color: #f1f5f1; }
  .settings-intro__description,
  .section-heading__note,
  .logout-note,
  .guest-note__detail { color: #b9c5bb; }
  .settings-group { border-color: #405445; background: #202b22; }
  .avatar-row__title { color: #f1f5f1; }
  .avatar-img { border-color: #18231b; }
  .avatar-img--placeholder { background: #294133; }
  .field-divider { background: #405445; }
  .settings-input { border-color: #405445; background: #18231b; color: #f1f5f1; }
  .settings-group .btn-secondary { border-color: #476653; background: #294133; color: #d8eadc; }
  .logout-area { border-color: #405445; }
  .logout-button { border-color: rgba(222, 105, 99, 0.34); background: rgba(200, 75, 69, 0.1); color: #ee8c87; }
}
