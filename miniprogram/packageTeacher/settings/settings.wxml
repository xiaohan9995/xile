<view class="page-shell settings-page">
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">个人设置</text>
    <view class="page-header__right"></view>
  </view>

  <view class="settings-body">
    <view class="settings-intro">
      <text class="settings-intro__eyebrow">ACCOUNT SETTINGS</text>
      <text class="settings-intro__title">个人资料与安全</text>
      <text class="settings-intro__description">管理公开喜乐名与教师账号密码</text>
    </view>

    <view wx:if="{{mustChangePassword}}" class="section-heading">
      <text class="section-heading__title">请先重置初始密码</text>
      <text class="section-heading__note">重置完成前不能使用其他功能</text>
    </view>

    <view wx:if="{{isTeacher && !mustChangePassword}}" class="section-heading">
      <text class="section-heading__title">个人资料</text>
      <text class="section-heading__note">喜乐名会展示在“我的”页面</text>
    </view>
    <view wx:if="{{isTeacher && !mustChangePassword}}" class="settings-group">
      <view class="field-block">
        <text class="field-label">喜乐名</text>
        <input
          class="settings-input"
          type="nickname"
          maxlength="20"
          confirm-type="done"
          placeholder="请输入喜乐名"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>
      <button
        class="action-button action-button--primary"
        bindtap="onSaveNickname"
        loading="{{savingNickname}}"
        disabled="{{savingNickname}}"
      >保存喜乐名</button>
    </view>

    <view wx:if="{{isTeacher && !mustChangePassword}}" class="section-heading section-heading--spaced">
      <text class="section-heading__title">公开资料</text>
      <text class="section-heading__note">控制师资查询页的展示内容</text>
    </view>
    <view wx:if="{{isTeacher && !mustChangePassword}}" class="settings-group">
      <view class="field-block"><text class="field-label">别名</text><input class="settings-input" maxlength="20" placeholder="未设置时不显示" value="{{alias}}" bindinput="onPublicInput" data-field="alias" /></view>
      <view class="field-block"><text class="field-label">经常居住地</text><input class="settings-input" maxlength="120" placeholder="最多 3 个，用顿号或逗号分隔" value="{{residencesText}}" bindinput="onPublicInput" data-field="residencesText" /></view>
      <view class="field-block"><text class="field-label">当前等级认证时间</text><picker mode="date" value="{{currentTierCertifiedOn}}" bindchange="onPublicInput" data-field="currentTierCertifiedOn"><view class="settings-input settings-picker">{{currentTierCertifiedOn || '请选择日期'}}</view></picker></view>
      <view class="field-block"><text class="field-label">个人简介</text><textarea class="settings-input settings-textarea" maxlength="500" placeholder="未填写时显示无" value="{{teachingSummary}}" bindinput="onPublicInput" data-field="teachingSummary" /></view>
      <view class="visibility-list">
        <view class="visibility-row"><text>公开别名</text><switch checked="{{visibility.showAlias}}" color="#426D58" bindchange="onVisibilityChange" data-field="showAlias" /></view>
        <view class="visibility-row"><text>公开经常居住地</text><switch checked="{{visibility.showResidences}}" color="#426D58" bindchange="onVisibilityChange" data-field="showResidences" /></view>
        <view class="visibility-row"><text>公开个人简介</text><switch checked="{{visibility.showBio}}" color="#426D58" bindchange="onVisibilityChange" data-field="showBio" /></view>
        <view class="visibility-row"><text>公开首次认证时间</text><switch checked="{{visibility.showFirstCertifiedOn}}" color="#426D58" bindchange="onVisibilityChange" data-field="showFirstCertifiedOn" /></view>
        <view class="visibility-row"><text>公开当前等级认证时间</text><switch checked="{{visibility.showCurrentTierCertifiedOn}}" color="#426D58" bindchange="onVisibilityChange" data-field="showCurrentTierCertifiedOn" /></view>
      </view>
      <button class="action-button action-button--primary" bindtap="savePublicProfile" loading="{{savingPublicProfile}}" disabled="{{savingPublicProfile}}">保存公开资料</button>
    </view>

    <view class="section-heading section-heading--spaced">
      <text class="section-heading__title">账户安全</text>
      <text class="section-heading__note">仅用于已关联的教师账号</text>
    </view>
    <view class="settings-group">
      <view class="field-block">
        <text class="field-label">当前密码</text>
        <input
          class="settings-input"
          password
          maxlength="64"
          placeholder="首次重置可不填"
          value="{{currentPassword}}"
          bindinput="onPasswordInput"
          data-field="currentPassword"
        />
      </view>
      <view class="field-divider"></view>
      <view class="field-block">
        <text class="field-label">新密码</text>
        <input
          class="settings-input"
          password
          maxlength="64"
          confirm-type="done"
          placeholder="至少 8 位字符"
          value="{{newPassword}}"
          bindinput="onPasswordInput"
          data-field="newPassword"
        />
      </view>
      <button
        class="action-button action-button--secondary"
        bindtap="changePassword"
        loading="{{changingPassword}}"
        disabled="{{changingPassword}}"
      >更新密码</button>
    </view>

    <view wx:if="{{!mustChangePassword}}" class="logout-area">
      <button class="logout-button" bindtap="onLogout">退出登录</button>
      <text class="logout-note">仅退出当前设备，不会删除个人资料</text>
    </view>
  </view>
</view>
