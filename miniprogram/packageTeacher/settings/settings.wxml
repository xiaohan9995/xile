<view class="page-shell settings-page">
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">个人设置</text>
    <view class="page-header__right"></view>
  </view>

  <view class="settings-body">
    <view class="settings-intro">
      <text class="settings-intro__eyebrow">ACCOUNT SETTINGS</text>
      <text class="settings-intro__title">个人资料与安全</text>
      <text class="settings-intro__description">管理公开昵称与教师账号密码</text>
    </view>

    <view class="section-heading">
      <text class="section-heading__title">个人资料</text>
      <text class="section-heading__note">昵称会展示在“我的”页面</text>
    </view>
    <view class="settings-group">
      <view class="field-block">
        <text class="field-label">昵称</text>
        <input
          class="settings-input"
          type="nickname"
          maxlength="20"
          confirm-type="done"
          placeholder="请输入昵称"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>
      <button
        class="action-button action-button--primary"
        bindtap="onSaveNickname"
        loading="{{savingNickname}}"
        disabled="{{savingNickname}}"
      >保存昵称</button>
    </view>

    <view class="section-heading section-heading--spaced">
      <text class="section-heading__title">账户安全</text>
      <text class="section-heading__note">仅用于已关联的教师账号</text>
    </view>
    <view class="settings-group">
      <view class="field-block">
        <text class="field-label">当前密码</text>
        <input
          class="settings-input"
          password
          maxlength="64"
          placeholder="首次修改可不填"
          value="{{currentPassword}}"
          bindinput="onPasswordInput"
          data-field="currentPassword"
        />
      </view>
      <view class="field-divider"></view>
      <view class="field-block">
        <text class="field-label">新密码</text>
        <input
          class="settings-input"
          password
          maxlength="64"
          confirm-type="done"
          placeholder="至少 8 位字符"
          value="{{newPassword}}"
          bindinput="onPasswordInput"
          data-field="newPassword"
        />
      </view>
      <button
        class="action-button action-button--secondary"
        bindtap="changePassword"
        loading="{{changingPassword}}"
        disabled="{{changingPassword}}"
      >更新密码</button>
    </view>

    <view class="logout-area">
      <button class="logout-button" bindtap="onLogout">退出登录</button>
      <text class="logout-note">仅退出当前设备，不会删除个人资料</text>
    </view>
  </view>
</view>
