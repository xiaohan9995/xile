<view class="login-page">
  <view class="login-shell" wx:if="{{loginReady}}">
    <view class="login-brand">
      <image class="login-brand__avatar" src="/assets/xile-yoga-miniapp-avatar.png" mode="aspectFill" alt="喜乐瑜伽标志" />
      <text class="login-brand__eyebrow">JOY YOGA</text>
      <text class="login-brand__name">喜乐瑜伽</text>
      <text class="login-brand__note">教师认证服务</text>
    </view>

    <view class="login-card">
      <text class="login-card__eyebrow">欢迎回来</text>
      <text class="login-card__heading">微信一键登录</text>
      <text class="login-card__sub">登录后即可浏览认证服务。讲师可继续查看证书、年审与教学记录。</text>

      <button class="wechat-btn" bindtap="onWechatLogin" loading="{{loading}}" disabled="{{loading}}">
        <image class="wechat-btn__icon" src="/assets/icons/wechat.svg" mode="aspectFit" alt="" />
        <text>使用微信登录</text>
      </button>

      <view class="login-divider"><text>或</text></view>
      <button class="account-btn" bindtap="goPasswordLogin">使用教师账号登录</button>
      <text class="security-note">手机号不是登录必填项；如需关联教师档案，可在个人设置中自愿绑定。</text>
    </view>

    <button class="skip-link" bindtap="onSkip">暂时不登录，先逛逛</button>
  </view>

  <view class="login-loading" wx:else><text>正在准备登录…</text></view>
</view>
