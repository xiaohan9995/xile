page {
  padding-bottom: 0;
  background: var(--color-bg);
}

.login-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 86% 8%, rgba(137, 101, 43, 0.14), transparent 30%),
    linear-gradient(180deg, #f3f7f3 0%, #f8faf7 56%, #f5f7f4 100%);
}

.login-shell {
  padding: 116rpx 40rpx calc(80rpx + env(safe-area-inset-bottom));
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.login-brand__avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 36rpx;
  box-shadow: var(--shadow-elevated);
}

.login-brand__eyebrow {
  display: block;
  margin-top: 26rpx;
  color: var(--color-gold);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.login-brand__name {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.login-brand__note {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 25rpx;
}

.login-card {
  padding: 48rpx 36rpx 40rpx;
  background: var(--color-card);
  border: 1rpx solid rgba(66, 109, 88, 0.1);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-elevated);
}

.login-card__eyebrow {
  display: block;
  color: var(--color-gold);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.login-card__heading {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.login-card__sub {
  display: block;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.wechat-btn,
.account-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-base);
  font-size: 30rpx;
  font-weight: 700;
  transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
}

.wechat-btn {
  margin-top: 44rpx;
  background: var(--color-primary);
  color: #fff;
}

.wechat-btn:active,
.account-btn:active,
.skip-link:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.wechat-btn[disabled] {
  opacity: 0.6;
}

.wechat-btn__icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 14rpx;
}

.login-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.login-divider::before,
.login-divider::after {
  content: '';
  height: 1rpx;
  flex: 1;
  background: var(--color-line);
}

.login-divider text {
  padding: 0 20rpx;
}

.account-btn {
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  border: 1rpx solid rgba(66, 109, 88, 0.18);
}

.security-note {
  display: block;
  margin-top: 28rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}

.skip-link {
  display: block;
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  color: var(--color-primary-dark);
  font-size: 26rpx;
}

.login-loading {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 26rpx;
}
