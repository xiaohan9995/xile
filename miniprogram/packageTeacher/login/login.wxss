/* ===== Login Page ===== */
.login-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

/* ===== Visual Header ===== */
.login-visual {
  position: relative;
  height: 560rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #31503d 0%, #6f826f 55%, #a9905c 150%);
}

.login-visual__mask {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 18% 10%, rgba(255, 255, 255, 0.2), transparent 32%), radial-gradient(circle at 85% 85%, rgba(237, 216, 162, 0.27), transparent 35%);
}

.login-visual__brand {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}

.login-visual__name {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 8rpx;
  font-family: "Noto Serif SC", serif;
}

.login-visual__tagline {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 6rpx;
}

/* ===== Form Area ===== */
.login-form-area {
  flex: 1;
  margin-top: -60rpx;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 3;
}

/* ===== Card ===== */
.login-card {
  width: 100%;
  padding: 56rpx 44rpx 48rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-card__heading {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1rpx;
}

.login-card__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 40rpx;
}

/* ===== Avatar Picker ===== */
.avatar-picker {
  margin-top: 40rpx;
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border: none;
  background: transparent;
  line-height: normal;
}

.avatar-picker::after {
  display: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(120, 136, 122, 0.2);
}

.avatar-empty {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #f0ede7, #e8e4dd);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(120, 136, 122, 0.15);
}

.avatar-empty__plus {
  font-size: 64rpx;
  font-weight: 200;
  color: var(--color-primary);
  line-height: 1;
  margin-top: -4rpx;
}

.avatar-hint {
  margin-top: 16rpx;
  margin-bottom: 36rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* ===== Input Field ===== */
.field {
  width: 100%;
  margin-bottom: 36rpx;
}

.field__input {
  width: 100%;
  height: 92rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: var(--color-text);
  background: var(--color-bg);
  border-radius: 16rpx;
  border: 1rpx solid var(--color-line);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.field__input:focus {
  border-color: var(--color-primary);
}

/* ===== Button ===== */
.btn-primary {
  width: 100% !important;
  height: 92rpx;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(120, 136, 122, 0.3);
}

.btn-primary::after {
  display: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(120, 136, 122, 0.2);
}

/* ===== Phone Step ===== */
.phone-illust {
  margin: 32rpx 0 40rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-illust__icon {
  font-size: 52rpx;
}

.wechat-mark {
  width: 112rpx;
  height: 112rpx;
  margin: 32rpx 0 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #12b965;
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(18, 185, 101, 0.18);
}

.wechat-mark text { font-size: 52rpx; font-weight: 700; }

.password-link {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--color-primary-dark);
}

.security-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* ===== Footer ===== */
.skip-link {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: var(--color-muted);
  letter-spacing: 1rpx;
}

.skip-link:active {
  color: var(--color-primary);
}

/* ===== Loading ===== */
.login-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}
