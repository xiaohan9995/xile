.success-page {
  min-height: 100vh;
  padding: 120rpx 42rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 50% 8%, rgba(93, 114, 97, 0.18), transparent 32%),
    #faf8f5;
}

.success-card {
  min-height: 760rpx;
  padding: 74rpx 42rpx 46rpx;
  border: 1rpx solid #edf0ee;
  border-radius: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  text-align: center;
  box-shadow: 0 24rpx 60rpx rgba(93, 114, 97, 0.12);
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #fef3c7;
  color: #d97706;
  font-size: 68rpx;
  font-weight: 900;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(217, 119, 6, 0.15);
}

.success-title {
  margin-top: 34rpx;
  color: #1f2937;
  font-size: 42rpx;
  font-weight: 900;
}

.success-desc {
  margin-top: 18rpx;
  color: #7e8a82;
  font-size: 25rpx;
  line-height: 1.8;
}

.success-meta {
  width: 100%;
  margin: 48rpx 0;
  padding: 26rpx;
  border-radius: 30rpx;
  display: grid;
  gap: 18rpx;
  background: #f8faf9;
}

.success-meta view {
  display: flex;
  justify-content: space-between;
  color: #8a938b;
  font-size: 24rpx;
}

.success-meta text:last-child {
  color: #1f2937;
  font-weight: 800;
}

.primary,
.ghost {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.primary {
  color: #fff;
  background: #5d7261;
  box-shadow: 0 14rpx 28rpx rgba(93, 114, 97, 0.24);
}

.ghost {
  margin-top: 18rpx;
  color: #5d7261;
  background: #f0f3f1;
}
