.profile-page {
  min-height: 100vh;
  padding-top: 0;
  background: var(--color-bg);
}

.profile-body {
  padding: 28rpx 28rpx 56rpx;
}

.identity-card {
  padding: 30rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #f2f7f2 0%, #e5efe7 100%);
  border: 1rpx solid rgba(66, 109, 88, 0.16);
  box-shadow: var(--shadow-card);
}

.identity-card--teacher {
  background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  border-color: transparent;
  box-shadow: var(--shadow-elevated);
}

/* Guests see the same card layout, but the avatar is not editable and the
   identity is not resolved yet — keep it visually quieter. */
.identity-card--guest {
  background: linear-gradient(135deg, #4a5f52 0%, #6d8273 100%);
}

.identity-card__top {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.avatar-editor {
  min-width: 112rpx;
  max-width: 112rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
}

.avatar-editor:active {
  opacity: 0.82;
  transform: scale(0.96);
}

.avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-md);
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
  background: var(--color-card);
}

.avatar-img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #d8e5da;
  border-color: rgba(66, 109, 88, 0.18);
}

.identity-card--teacher .avatar-img--placeholder {
  background: rgba(255, 255, 255, 0.16);
  border-color: rgba(255, 255, 255, 0.36);
}

.avatar-initial {
  color: var(--color-primary-dark);
  font-size: 48rpx;
  font-weight: 800;
}

.identity-card--teacher .avatar-initial {
  color: #fff;
}

.avatar-badge {
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--color-card);
  border-radius: 50%;
  background: var(--color-gold);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.avatar-badge--edit {
  border-color: #f2f7f2;
  background: var(--color-primary-dark);
  font-size: 18rpx;
  font-weight: 700;
}

.identity-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.identity-name {
  display: block;
  overflow: hidden;
  color: var(--color-text);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-role,
.identity-bio {
  display: block;
  margin-top: 8rpx;
  color: var(--color-primary-dark);
  font-size: 23rpx;
  line-height: 1.5;
}

.identity-bio {
  color: var(--color-muted);
}

.identity-card--teacher .identity-name,
.identity-card--teacher .identity-role,
.identity-card--teacher .identity-bio {
  color: #fff;
}

.identity-card--teacher .identity-role { color: #f4e8cf; }
.identity-card--teacher .identity-bio { color: rgba(255, 255, 255, 0.76); }

.primary-status-card {
  width: 100%;
  min-width: 100%;
  max-width: none;
  min-height: 144rpx;
  margin: 20rpx 0 0;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  box-sizing: border-box;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-status-card--account {
  border-color: transparent;
  background: linear-gradient(125deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  box-shadow: var(--shadow-elevated);
}

.primary-status-card:active,
.menu-item:active { transform: scale(0.98); opacity: 0.84; }

.primary-status-card__content { display: flex; flex: 1; flex-direction: column; min-width: 0; padding-right: 20rpx; }
.primary-status-card__eyebrow { display: block; color: var(--color-gold); font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.primary-status-card__title { margin-top: 5rpx; color: var(--color-text); font-size: 30rpx; font-weight: 800; }
.primary-status-card__detail { margin-top: 6rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.5; }
.primary-status-card__action { display: flex; flex-shrink: 0; align-items: center; justify-content: flex-end; min-width: 112rpx; margin-left: 8rpx; color: var(--color-primary-dark); font-size: 24rpx; font-weight: 700; white-space: nowrap; }
.primary-status-card__arrow { margin-left: 8rpx; font-size: 38rpx; font-weight: 300; line-height: 1; }

.primary-status-card--account .primary-status-card__eyebrow { color: #ead9b7; }
.primary-status-card--account .primary-status-card__title,
.primary-status-card--account .primary-status-card__action { color: #fff; }
.primary-status-card--account .primary-status-card__detail { color: rgba(255, 255, 255, 0.76); }

.section-heading {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 38rpx;
  padding: 0 4rpx 14rpx;
}

.section-heading__title { color: var(--color-text); font-size: 30rpx; font-weight: 800; }
.section-heading__note { margin-top: 6rpx; color: var(--color-muted); font-size: 21rpx; text-align: left; }

.menu-list {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-card);
  box-shadow: var(--shadow-card);
}

.menu-item {
  width: 100%;
  min-width: 100%;
  max-width: none;
  min-height: 112rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--color-line);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.menu-item:last-child { border-bottom: none; }
.menu-item-left { display: flex; flex: 1; align-items: center; min-width: 0; }
.menu-icon { width: 64rpx; height: 64rpx; display: flex; flex-shrink: 0; align-items: center; justify-content: center; border-radius: var(--radius-base); background: var(--color-primary-light); color: var(--color-primary-dark); font-size: 24rpx; font-weight: 800; }
.menu-text { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 18rpx; }
.menu-title { color: var(--color-text); font-size: 28rpx; font-weight: 700; }
.menu-subtitle { margin-top: 4rpx; color: var(--color-muted); font-size: 22rpx; line-height: 1.45; }
.menu-arrow { margin-left: 16rpx; color: var(--color-muted); font-size: 38rpx; font-weight: 300; line-height: 1; }
.menu-lock { flex-shrink: 0; margin-left: 16rpx; padding: 4rpx 12rpx; border-radius: var(--radius-sm); background: var(--color-primary-light); color: var(--color-primary-dark); font-size: 20rpx; font-weight: 700; }

/* The 讲师服务 list is identical for guests and teachers; only the reachable
   entries differ. Dim the locked rows so the single open entry stands out. */
.menu-item--locked .menu-icon { background: rgba(66, 109, 88, 0.1); color: var(--color-muted); }
.menu-item--locked .menu-title { color: var(--color-muted); }

.logout-area {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--color-line);
  text-align: center;
}

.logout-button {
  width: 100%;
  min-width: 100%;
  max-width: none;
  height: 96rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(66, 109, 88, 0.28);
  border-radius: var(--radius-base);
  background: rgba(66, 109, 88, 0.06);
  color: var(--color-primary-dark);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.logout-button:active { opacity: 0.82; }

.logout-note {
  display: block;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

@media (prefers-color-scheme: dark) {
  .profile-page { background: #172019; }
  .profile-body { background: #172019; }
  .identity-card { background: #223127; border-color: #405445; }
  .identity-card--teacher { background: linear-gradient(135deg, #244a35 0%, #386448 100%); }
  .identity-name, .primary-status-card__title, .section-heading__title, .menu-title { color: #f1f5f1; }
  .identity-role { color: #b9d2c0; }
  .identity-bio, .primary-status-card__detail, .section-heading__note, .menu-subtitle, .menu-arrow { color: #b9c5bb; }
  .menu-lock { background: rgba(185, 210, 192, 0.16); color: #b9d2c0; }
  .primary-status-card, .menu-list { background: #202b22; border-color: #405445; }
  .primary-status-card--account { background: linear-gradient(125deg, #294d38 0%, #3b684c 100%); border-color: transparent; }
  .logout-area { border-color: #405445; }
  .logout-note { color: #b9c5bb; }
  .logout-button { border-color: rgba(119, 154, 132, 0.34); background: rgba(66, 109, 88, 0.14); color: #b9d2c0; }
}
