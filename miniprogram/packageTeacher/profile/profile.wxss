/* ===== Profile Page (讲师简介) ===== */
.profile-page {
  padding-top: 0;
}

.profile-body {
  padding: 0 32rpx;
}

/* Avatar Section */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx;
  background: var(--color-card);
  margin: 0 -32rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  border: 6rpx solid var(--color-primary-light);
  box-shadow: 0 8rpx 24rpx rgba(93, 114, 97, 0.12);
}

.avatar-badge {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-gold);
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  box-shadow: 0 4rpx 8rpx rgba(187, 161, 120, 0.3);
}

.profile-name {
  display: block;
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
}

.level-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  background: rgba(212, 175, 55, 0.12);
  border: 1rpx solid rgba(212, 175, 55, 0.25);
}

.level-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-gold);
}

.level-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

.profile-bio {
  display: block;
  margin-top: 24rpx;
  padding: 0 40rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.8;
  text-align: center;
  font-style: italic;
}

/* Metrics Grid */
.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 32rpx;
}

.metric-card {
  padding: 28rpx 20rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-muted);
  font-weight: 500;
}

.metric-value {
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-text);
}

/* Menu List */
.menu-list {
  margin-top: 32rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  margin-bottom: 40rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(93, 114, 97, 0.03);
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.menu-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.menu-text {
  display: flex;
  flex-direction: column;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.menu-subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.menu-arrow {
  color: var(--color-muted);
  font-size: 36rpx;
  font-weight: 300;
  flex-shrink: 0;
}
