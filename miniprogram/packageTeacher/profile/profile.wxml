<view class="page-shell profile-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">讲师简介</text>
    <view class="page-header__right"></view>
  </view>

  <view class="profile-body">
    <!-- Avatar Section -->
    <view class="avatar-section">
      <view class="avatar-wrap">
        <image class="avatar-img" src="{{teacher.avatarUrl}}" mode="aspectFill" />
        <view class="avatar-badge">✓</view>
      </view>
      <text class="profile-name">{{teacher.name}}</text>
      <view class="level-badge">
        <view class="level-dot"></view>
        <text class="level-text">{{teacher.tier}} {{teacher.tierName}}</text>
      </view>
      <text class="profile-bio" wx:if="{{teacher.bio}}">「{{teacher.bio}}」</text>
    </view>

    <!-- Metrics Grid -->
    <view class="metrics-grid">
      <view class="metric-card">
        <text class="metric-label">🗓 认证到期</text>
        <text class="metric-value">{{teacher.validUntil}}</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">⏱ 认证天数</text>
        <text class="metric-value">{{teacher.daysLeft}} 天</text>
      </view>
    </view>

    <!-- Menu List -->
    <view class="menu-list">
      <view
        wx:for="{{menuItems}}"
        wx:key="title"
        class="menu-item"
        bindtap="onMenuTap"
        data-url="{{item.url}}"
      >
        <view class="menu-item-left">
          <text class="menu-icon">{{item.icon}}</text>
          <view class="menu-text">
            <text class="menu-title">{{item.title}}</text>
            <text class="menu-subtitle">{{item.subtitle}}</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
<tab-bar active="my" />
</view>
