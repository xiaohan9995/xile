<view class="page-shell profile-page">
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">我的认证</text>
    <view class="page-header__right"></view>
  </view>

  <view class="profile-body">
    <view class="identity-card identity-card--teacher {{isGuest ? 'identity-card--guest' : ''}}">
      <view class="identity-card__top">
        <button
          class="avatar-wrap avatar-editor"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          disabled="{{avatarUploading || isGuest}}"
          aria-label="更换头像"
        >
          <image wx:if="{{teacher.avatarUrl || user.avatarUrl}}" class="avatar-img" src="{{teacher.avatarUrl || user.avatarUrl}}" mode="aspectFill" alt="{{user.nickname || teacher.name || '微信用户'}}的头像" />
          <view wx:else class="avatar-img avatar-img--placeholder">
            <text class="avatar-initial">{{teacher.xileName[0] || user.nickname[0] || teacher.name[0] || '我'}}</text>
          </view>
          <view wx:if="{{!isGuest}}" class="avatar-badge avatar-badge--edit">{{avatarUploading ? '…' : '换'}}</view>
        </button>

        <view class="identity-info">
          <text class="identity-name">{{teacher.xileName || user.nickname || teacher.name || '微信用户'}}</text>
          <view class="identity-role">
            <text wx:if="{{isTeacher}}">{{teacher.tier}} {{teacher.tierName}}</text>
            <text wx:else>微信用户 · 尚未关联讲师档案</text>
          </view>
          <text class="identity-bio" wx:if="{{isTeacher && teacher.bio}}">{{teacher.bio}}</text>
          <text class="identity-bio" wx:elif="{{isTeacher}}">认证信息已同步至喜乐瑜伽教师服务</text>
          <text class="identity-bio" wx:else>认证信息已同步至喜乐瑜伽教师服务</text>
        </view>
      </view>
    </view>

    <button
      wx:if="{{primaryAction.title}}"
      class="primary-status-card primary-status-card--account"
      bindtap="onMenuTap"
      data-url="{{primaryAction.url}}"
      data-primary="1"
    >
      <view class="primary-status-card__content">
        <text class="primary-status-card__eyebrow">{{primaryAction.eyebrow}}</text>
        <text class="primary-status-card__title">{{primaryAction.title}}</text>
        <text class="primary-status-card__detail">{{primaryAction.detail}}</text>
      </view>
      <view class="primary-status-card__action">
        <text>{{primaryAction.actionText}}</text>
        <text class="primary-status-card__arrow">›</text>
      </view>
    </button>

    <view class="section-heading">
      <text class="section-heading__title">讲师服务</text>
      <text class="section-heading__note">管理你的认证资料与年度记录</text>
    </view>

    <view class="menu-list">
      <button
        wx:for="{{menuItems}}"
        wx:key="title"
        class="menu-item {{item.locked ? 'menu-item--locked' : ''}}"
        bindtap="onMenuTap"
        data-url="{{item.url}}"
        data-action="{{item.action}}"
      >
        <view class="menu-item-left">
          <text class="menu-icon">{{item.icon}}</text>
          <view class="menu-text">
            <text class="menu-title">{{item.title}}</text>
            <text class="menu-subtitle">{{item.subtitle}}</text>
          </view>
        </view>
        <text class="menu-lock" wx:if="{{item.locked}}">仅教师</text>
        <text class="menu-arrow" wx:else>›</text>
      </button>

      <!-- 咨询服务 is a native customer-service session, so it must be a
           standalone button with open-type="contact" (open-type cannot be
           bound dynamically inside the wx:for above). -->
      <button
        class="menu-item"
        open-type="contact"
        session-from="profile"
      >
        <view class="menu-item-left">
          <text class="menu-icon">询</text>
          <view class="menu-text">
            <text class="menu-title">咨询服务</text>
            <text class="menu-subtitle">与师资管理小助手在线沟通</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </button>
    </view>

    <view wx:if="{{isLoggedIn}}" class="logout-area">
      <button class="logout-button" bindtap="onLogout">退出登录</button>
      <text class="logout-note">仅退出当前设备，不会删除个人资料</text>
    </view>
  </view>
  <tab-bar active="my" />
</view>
