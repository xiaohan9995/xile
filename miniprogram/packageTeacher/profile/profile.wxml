<view class="page-shell profile-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">{{isTeacher ? '我的认证' : '我的'}}</text>
    <navigator class="page-header__right page-header__home" url="/pages/index/index" open-type="reLaunch">首页</navigator>
  </view>

  <view class="profile-body">
    <!-- Teacher Profile -->
    <view wx:if="{{isTeacher}}" class="avatar-section">
      <view class="avatar-wrap">
        <image wx:if="{{teacher.avatarUrl}}" class="avatar-img" src="{{teacher.avatarUrl}}" mode="aspectFill" alt="{{teacher.name}}的头像" />
        <view wx:else class="avatar-img avatar-img--placeholder">
          <text class="avatar-initial">{{teacher.name[0] || '?'}}</text>
        </view>
        <view class="avatar-badge">✓</view>
      </view>
      <text class="profile-name">{{teacher.name}}</text>
      <view class="level-badge">
        <view class="level-dot"></view>
        <text class="level-text">{{teacher.tier}} {{teacher.tierName}}</text>
      </view>
      <text class="profile-bio" wx:if="{{teacher.bio}}">「{{teacher.bio}}」</text>
    </view>

    <!-- Non-Teacher Profile -->
    <view wx:else class="avatar-section">
      <view class="avatar-wrap">
        <image wx:if="{{user.avatarUrl}}" class="avatar-img" src="{{user.avatarUrl}}" mode="aspectFill" alt="{{user.nickname}}的头像" />
        <view wx:else class="avatar-img avatar-img--placeholder">
          <text class="avatar-initial">{{user.nickname[0] || '我'}}</text>
        </view>
      </view>
      <text class="profile-name">{{user.nickname || '用户'}}</text>
      <view class="level-badge level-badge--student">
        <text class="level-text">普通用户</text>
      </view>
    </view>

    <!-- Metrics Grid (teacher only) -->
    <view wx:if="{{isTeacher}}" class="metrics-grid">
      <view class="metric-card">
        <text class="metric-label">🗓 认证到期</text>
        <text class="metric-value">{{teacher.validUntil}}</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">⏱ 认证天数</text>
        <text class="metric-value">{{teacher.daysLeft}} 天</text>
      </view>
    </view>

    <!-- Non-Teacher Prompt -->
    <view wx:if="{{!isTeacher}}" class="not-teacher-prompt">
      <text class="prompt-text">尚未关联讲师档案</text>
      <text class="prompt-hint">可使用管理员提供的教师账号关联档案；手机号可在个人设置中自愿绑定。</text>
    </view>

    <!-- Menu List -->
    <view class="menu-list">
      <view
        wx:for="{{menuItems}}"
        wx:key="title"
        class="menu-item"
        bindtap="onMenuTap"
        data-url="{{item.url}}"
      >
        <view class="menu-item-left">
          <text class="menu-icon">{{item.icon}}</text>
          <view class="menu-text">
            <text class="menu-title">{{item.title}}</text>
            <text class="menu-subtitle">{{item.subtitle}}</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
<tab-bar active="my" />
</view>
