/* Shared progress-strip (step indicator) */
.progress-strip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 40rpx;
  background: var(--color-card);
  border-bottom: 1rpx solid var(--color-line);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  text-align: center;
  background: #e5e7eb;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.step-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-muted);
}

.step-item--active .step-dot {
  background: var(--color-primary);
  box-shadow: 0 0 0 8rpx rgba(93, 114, 97, 0.15);
}

.step-item--active .step-label {
  color: var(--color-primary);
}

.step-item--done .step-dot {
  background: var(--color-gold);
}

.step-item--done .step-label {
  color: var(--color-gold);
}

.step-line {
  width: 60rpx;
  height: 2rpx;
  margin: 0 12rpx;
  background: #e5e7eb;
}

.step-line--done {
  background: var(--color-gold);
}
