.banner-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.banner-body {
  padding: 28rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
}

.banner-intro {
  padding: 18rpx 4rpx 30rpx;
}

.banner-intro__eyebrow {
  display: block;
  color: var(--color-gold);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.banner-intro__title {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.banner-intro__description {
  display: block;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.banner-group {
  overflow: hidden;
  padding: 0 28rpx 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-md);
  background: var(--color-card);
}

.banner-field {
  padding-top: 26rpx;
}

.banner-field__label {
  display: block;
  margin-bottom: 13rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 600;
}

.banner-preview {
  position: relative;
  height: 320rpx;
  border-radius: var(--radius-base);
  overflow: hidden;
  background: var(--color-surface);
}

.banner-preview__img {
  width: 100%;
  height: 100%;
}

.banner-preview__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 100%;
  color: var(--color-muted);
  font-size: 24rpx;
}

.banner-preview__plus {
  color: var(--color-primary-dark);
  font-size: 52rpx;
  font-weight: 700;
}

.banner-preview__mask {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 12rpx 0;
  text-align: center;
  color: #fff;
  background: rgba(23, 32, 25, 0.45);
  font-size: 22rpx;
}

/* 保存按钮：与「我的认证」页退出登录按钮同风格（浅绿底 + 细边框 + 深绿字），
   并附保存图标与“保存后立即生效”说明。 */
.save-button {
  box-sizing: border-box;
  width: 100%;
  min-width: 100%;
  max-width: none;
  height: 96rpx;
  margin: 26rpx 0 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1rpx solid rgba(66, 109, 88, 0.28);
  border-radius: var(--radius-base);
  background: rgba(66, 109, 88, 0.06);
  color: var(--color-primary-dark);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}

.save-button:active { opacity: 0.82; }

.save-button__icon {
  width: 36rpx;
  height: 36rpx;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjMmY1MTQwJyBzdHJva2Utd2lkdGg9JzInIHN0cm9rZS1saW5lY2FwPSdyb3VuZCcgc3Ryb2tlLWxpbmVqb2luPSdyb3VuZCc+PHBhdGggZD0nTTIwIDYgOSAxN2wtNS01Jy8+PC9zdmc+");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.save-note {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 20rpx;
}

@media (prefers-color-scheme: dark) {
  .banner-page { background: #172019; }
  .banner-intro__title,
  .banner-field__label { color: #f1f5f1; }
  .banner-intro__description { color: #b9c5bb; }
  .banner-group { border-color: #405445; background: #202b22; }
  .banner-preview { background: #18231b; }
  .save-button { border-color: rgba(119, 154, 132, 0.34); background: rgba(66, 109, 88, 0.14); color: #b9d2c0; }
  .save-button__icon { filter: brightness(2.4); }
  .save-note { color: #b9c5bb; }
}
