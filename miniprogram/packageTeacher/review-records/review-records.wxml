<view class="page-shell records-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">年审记录</text>
    <view class="page-header__right"></view>
  </view>

  <view class="records-body">
    <!-- Skeleton loading -->
    <skeleton wx:if="{{loading}}" type="review-list" count="{{3}}" />

    <!-- Current level section -->
    <view wx:if="{{!loading}}" class="current-level">
      <text class="current-label">当前认证等级</text>
      <view class="current-main">
        <text class="current-tier">{{current.tier}}</text>
        <text class="current-name">{{current.tierName}}</text>
      </view>
      <text class="current-expiry">有效期至：{{current.validUntil}}</text>
    </view>

    <!-- Record tabs -->
    <view wx:if="{{!loading}}" class="record-tabs">
      <view class="record-tab {{activeTab === 'all' ? 'record-tab--active' : ''}}" bindtap="switchTab" data-tab="all">全部记录</view>
      <view class="record-tab {{activeTab === 'passed' ? 'record-tab--active' : ''}}" bindtap="switchTab" data-tab="passed">已通过</view>
    </view>

    <!-- Timeline list -->
    <view wx:if="{{!loading && records.length === 0}}" class="empty-records">
      <text class="empty-text">暂无年审记录</text>
    </view>

    <view wx:if="{{!loading}}" class="timeline-list">
      <view
        wx:for="{{records}}"
        wx:key="year"
        class="timeline-item"
      >
        <text class="timeline-title">{{item.year}}</text>
        <text class="timeline-status {{item.statusClass}}">{{item.statusText}}</text>
        <view class="timeline-meta">
          <text>{{item.date}}</text>
          <text wx:if="{{item.reviewer}}"> · 审核人：{{item.reviewer}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
