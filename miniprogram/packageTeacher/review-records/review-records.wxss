/* ===== 审核记录页 - 严格对照设计稿 ===== */
.records-page {
  min-height: 100vh;
  background: #F5F5F0;
}

.records-body {
  padding: 0 28rpx 40rpx;
}

/* 当前认证信息卡（绿色） */
.cert-info-card {
  margin-top: 28rpx;
  padding: 28rpx;
  background: #7B9E7A;
  border-radius: 24rpx;
}

.cert-tag {
  display: block;
  color: rgba(255, 248, 231, 0.85);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.cert-level-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 12rpx;
}

.cert-level-code {
  color: #FFFFFF;
  font-family: "STSong", "Noto Serif SC", serif;
  font-size: 56rpx;
  font-weight: 900;
}

.cert-level-name {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
}

.cert-expiry {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
}

/* 切换Tab */
.tab-switch {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  margin-bottom: 20rpx;
}

.tab-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 34rpx;
  background: #FFFFFF;
  color: #7E857E;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid rgba(123, 158, 122, 0.10);
}

.tab-btn--active {
  background: #7B9E7A;
  color: #FFFFFF;
  border-color: #7B9E7A;
}

/* 时间线列表 */
.timeline-list {
  max-height: calc(100vh - 580rpx);
}

.record-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 24rpx 48rpx;
  margin-bottom: 14rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid rgba(123, 158, 122, 0.06);
}

.record-dot {
  position: absolute;
  left: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7B9E7A;
}

.record-body {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
}

.record-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.record-status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.record-status--passed {
  background: rgba(180, 150, 88, 0.12);
  color: #B49658;
}
