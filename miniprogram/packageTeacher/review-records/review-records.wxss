/* ===== Review Records Page ===== */
.records-page {
  padding-top: 0;
}

.records-body {
  padding: 0 32rpx 60rpx;
}

/* ===== Current level section ===== */
.current-level {
  margin-top: 24rpx;
  padding: 36rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-line);
}

.current-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-muted);
}

.current-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 8rpx;
}

.current-tier {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--color-gold);
  font-style: normal;
  line-height: 1.1;
}

.current-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.current-expiry {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

/* ===== Record tabs ===== */
.record-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 28rpx 0;
}

.record-tab {
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-muted);
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
}

.record-tab--active {
  color: var(--color-primary-dark);
  border-bottom: 4rpx solid var(--color-primary);
  border-radius: 0;
  background: transparent;
  border-left: none;
  border-right: none;
  border-top: none;
}

/* ===== Timeline list ===== */
.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.timeline-item {
  position: relative;
  padding: 28rpx 28rpx 28rpx 48rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-line);
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 40rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.timeline-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.timeline-status {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.timeline-status.status-approved {
  color: var(--color-primary-dark);
}

.timeline-status.status-submitted {
  color: var(--color-gold);
}

.timeline-status.status-rejected {
  color: var(--color-danger);
}

.timeline-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* ===== Empty state ===== */
.empty-records {
  padding: 60rpx;
  text-align: center;
}
