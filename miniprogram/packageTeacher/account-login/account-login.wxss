.login-page { min-height: 100vh; background: var(--color-bg); }
.login-intro { display: flex; flex-direction: column; align-items: center; padding: 28rpx 48rpx 46rpx; }
.login-intro__avatar { width: 108rpx; height: 108rpx; border-radius: var(--radius-md); }
.login-intro__title { display: block; margin-top: 22rpx; color: var(--color-text); font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.login-intro__note { display: block; margin-top: 10rpx; color: var(--color-muted); font-size: 25rpx; text-align: center; }
.login-card { margin: 0 32rpx; padding: 8rpx 32rpx 34rpx; border-radius: var(--radius-md); background: var(--color-card); box-sizing: border-box; }
.form-cell { padding: 24rpx 0 20rpx; border-bottom: 1rpx solid var(--color-line); }
.form-cell__label { display: block; margin-bottom: 14rpx; color: var(--color-muted); font-size: 26rpx; }
.field { width: 100%; height: 80rpx; padding: 0; color: var(--color-text); font-size: 28rpx; border: 0; box-sizing: border-box; }
.login-card .btn-primary { margin-top: 40rpx; }
.help { display: block; margin-top: 22rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.6; }
.wechat-link { display: block; margin-top: 38rpx; color: var(--color-primary-dark); font-size: 27rpx; text-align: center; }
.wechat-link:active { opacity: 0.7; }

/* 桌面端适配 */
@media (min-width: 700px) {
  .login-page { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 56px 24px; box-sizing: border-box; }
  .login-intro { padding: 8px 0 30px; }
  .login-intro__avatar { width: 72px; height: 72px; border-radius: 16px; }
  .login-intro__title { margin-top: 14px; font-size: 26px; }
  .login-intro__note { margin-top: 6px; font-size: 14px; }
  .login-card { width: 100%; max-width: 440px; margin: 0 auto; padding: 4px 28px 26px; border-radius: 14px; }
  .form-cell { padding: 16px 0 14px; }
  .form-cell__label { margin-bottom: 8px; font-size: 14px; }
  .field { height: 38px; font-size: 16px; }
  .login-card .btn-primary { height: 50px; margin-top: 26px; font-size: 16px; }
  .help { margin-top: 14px; font-size: 13px; }
  .wechat-link { margin-top: 24px; font-size: 14px; }
}
