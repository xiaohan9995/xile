.login-page { min-height:100vh; background:#f7f8f5; } .login-card { margin:120rpx 32rpx; padding:48rpx 36rpx; border-radius:28rpx; background:#fff; box-shadow:0 16rpx 44rpx rgba(45,73,55,.08); } .title { display:block; font-size:42rpx; color:#25352a; font-weight:700; } .hint,.help { display:block; margin-top:16rpx; color:#65706a; font-size:26rpx; line-height:1.6; } .field { box-sizing:border-box; width:100%; height:88rpx; padding:0 24rpx; margin-top:26rpx; border:1rpx solid #d7dfd8; border-radius:14rpx; background:#fbfcfb; } .primary { margin-top:32rpx; background:#4a7c59; color:#fff; border-radius:16rpx; }
