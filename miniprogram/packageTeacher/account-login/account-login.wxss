.login-page { min-height: 100vh; background: #f7f8f5; }
.login-nav { height: 88rpx; padding-left: 24rpx; box-sizing: border-box; }
.login-nav__back { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; color: #25352a; font-size: 52rpx; font-weight: 300; line-height: 1; }
.login-nav__back:active { background: rgba(37, 53, 42, 0.06); border-radius: 50%; }
.login-intro { display: flex; flex-direction: column; align-items: center; padding: 28rpx 48rpx 46rpx; }
.login-intro__avatar { width: 108rpx; height: 108rpx; border-radius: 24rpx; }
.login-intro__title { display: block; margin-top: 22rpx; color: #25352a; font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.login-intro__note { display: block; margin-top: 10rpx; color: #7b857e; font-size: 25rpx; text-align: center; }
.login-card { margin: 0 32rpx; padding: 8rpx 32rpx 34rpx; border-radius: 20rpx; background: #fff; box-sizing: border-box; }
.form-cell { padding: 24rpx 0 20rpx; border-bottom: 1rpx solid #ecefeb; }
.form-cell__label { display: block; margin-bottom: 14rpx; color: #4a564e; font-size: 26rpx; }
.field { width: 100%; height: 66rpx; padding: 0; color: #25352a; font-size: 30rpx; border: 0; box-sizing: border-box; }
.primary { width: 100%; height: 92rpx; margin-top: 40rpx; border-radius: 12rpx; background: #537f61; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 92rpx; }
.primary:active { background: #456d52; }
.help { display: block; margin-top: 22rpx; color: #969e98; font-size: 23rpx; line-height: 1.6; }
.wechat-link { display: block; margin-top: 38rpx; color: #537f61; font-size: 27rpx; text-align: center; }

/* 桌面端适配 */
@media (min-width: 700px) {
  .login-page { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 56px 24px; box-sizing: border-box; }
  .login-intro { padding: 8px 0 30px; }
  .login-intro__avatar { width: 72px; height: 72px; border-radius: 16px; }
  .login-intro__title { margin-top: 14px; font-size: 26px; }
  .login-intro__note { margin-top: 6px; font-size: 14px; }
  .login-card { width: 100%; max-width: 440px; margin: 0 auto; padding: 4px 28px 26px; border-radius: 14px; }
  .form-cell { padding: 16px 0 14px; }
  .form-cell__label { margin-bottom: 8px; font-size: 14px; }
  .field { height: 38px; font-size: 16px; }
  .primary { height: 50px; margin-top: 26px; border-radius: 25px; font-size: 16px; line-height: 50px; }
  .help { margin-top: 14px; font-size: 13px; }
  .wechat-link { margin-top: 24px; font-size: 14px; }
}
