@import "../teaching-records/teaching-records.wxss";

.studio-card { box-sizing:border-box; margin-bottom:20rpx; padding:30rpx; border:1rpx solid var(--color-line); border-radius:var(--radius-md); background:var(--color-card); box-shadow:var(--shadow-card); }
.studio-card__head { display:flex; justify-content:space-between; align-items:center; gap:16rpx; }
.studio-card__name { color:var(--color-text); font-family:"Noto Serif SC", "Songti SC", serif; font-size:36rpx; font-weight:700; }
.status-pill { flex-shrink:0; padding:6rpx 20rpx; border-radius:999rpx; font-size:22rpx; }
.status-pill--open { color:#2f5140; background:rgba(66,109,88,0.14); }
.status-pill--pending { color:#9c7a1a; background:rgba(180,140,40,0.16); }
.status-pill--incomplete { color:var(--color-muted); background:var(--color-surface); }

.studio-card__teachers { margin-top:14rpx; color:var(--color-muted); font-size:24rpx; line-height:1.6; }
.studio-card__reject { margin-top:14rpx; padding:16rpx; border-radius:var(--radius-base); background:rgba(180,140,40,0.10); color:#8a6d1c; font-size:24rpx; line-height:1.6; }
.studio-card__reject-label { display:block; margin-bottom:4rpx; font-weight:700; }
.studio-card__actions { display:flex; gap:16rpx; margin-top:22rpx; }
.studio-card__actions button { flex:1; margin:0; }
.studio-card__action { margin-top:22rpx; }

.form-card__head { display:flex; justify-content:space-between; align-items:center; }
.form-card__close { color:var(--color-muted); font-size:44rpx; line-height:1; padding:0 8rpx; }
.form-card__hint { margin-bottom:24rpx; color:var(--color-gold); }

.tag-section, .image-section { margin-bottom:16rpx; }
.form-field { margin-bottom:24rpx; }
.form-field__label { display:block; margin-bottom:10rpx; color:var(--color-text); font-size:26rpx; font-weight:600; }
/* 地址栏：手动输入为主，「地图选点」按钮一键回填地址与城市/地区 */
.address-row { display:flex; align-items:center; gap:16rpx; }
.address-input { flex:1; min-width:0; margin-bottom:0; }
.address-pick { flex-shrink:0; width:48rpx; height:48rpx; background-image: url("data:image/svg+xml;base64,"); background-repeat:no-repeat; background-position:center; background-size:100% 100%; }
/* 城市 / 地区：只读展示，由地图选点自动填充，视觉上弱化以区别于可编辑输入 */
.region-row { display:flex; gap:16rpx; }
.region-row .field { flex:1; min-width:0; margin-bottom:0; }
.field--readonly { background:var(--color-surface); color:var(--color-muted); }
.tag-list { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:12rpx; }
.tag-chip { display:flex; align-items:center; gap:8rpx; padding:8rpx 18rpx; border-radius:999rpx; background:rgba(66,109,88,0.12); color:var(--color-primary-dark); font-size:24rpx; }
.tag-chip__remove { color:var(--color-muted); font-size:28rpx; line-height:1; }
.tag-input-row { display:flex; gap:12rpx; align-items:center; }
.tag-input-row .field { flex:1; margin-bottom:0; min-height:64rpx; height:64rpx; padding:0 20rpx; font-size:24rpx; line-height:64rpx; }
.tag-add { flex-shrink:0; margin:0; width:auto; min-width:112rpx; height:64rpx; padding:0 24rpx; font-size:24rpx; line-height:64rpx; }
.field-hint { display:block; margin-top:10rpx; color:var(--color-muted); font-size:22rpx; }

.image-grid { display:flex; flex-wrap:wrap; gap:16rpx; }
.image-item, .image-add { position:relative; width:200rpx; height:200rpx; border-radius:var(--radius-base); overflow:hidden; }
.image-item image { width:100%; height:100%; }
.image-item__remove { position:absolute; top:0; right:0; width:48rpx; height:48rpx; line-height:48rpx; text-align:center; background:rgba(0,0,0,0.5); color:#fff; font-size:32rpx; }
.image-item__cover { position:absolute; bottom:0; left:0; right:0; padding:4rpx 0; text-align:center; background:rgba(66,109,88,0.85); color:#fff; font-size:20rpx; }
.image-add { display:flex; flex-direction:column; gap:6rpx; align-items:center; justify-content:center; border:1rpx dashed var(--color-primary); color:var(--color-primary-dark); }
.image-add__plus { font-size:52rpx; line-height:1; }
.image-add__label { font-size:22rpx; }

/* 联系工作室图片：单张，含电话/二维码等联系方式，详情页点选后预览 */
.contact-image { display:flex; }
.contact-image__preview, .contact-image__add { position:relative; width:280rpx; height:280rpx; border-radius:var(--radius-base); overflow:hidden; }
.contact-image__preview image { width:100%; height:100%; }
.contact-image__remove { position:absolute; top:0; right:0; width:48rpx; height:48rpx; line-height:48rpx; text-align:center; background:rgba(0,0,0,0.5); color:#fff; font-size:32rpx; }
.contact-image__add { display:flex; flex-direction:column; gap:6rpx; align-items:center; justify-content:center; border:1rpx dashed var(--color-primary); color:var(--color-primary-dark); }
.contact-image__plus { font-size:52rpx; line-height:1; }
.contact-image__label { font-size:22rpx; }

/* 管理教师：内嵌在当前编辑表单，位于详细地址上方 */
.teacher-mgmt { box-sizing:border-box; margin-bottom:24rpx; padding:24rpx; border:1rpx solid var(--color-line); border-radius:var(--radius-md); background:var(--color-surface); }
.teacher-mgmt__section + .teacher-mgmt__section { margin-top:28rpx; }
.teacher-mgmt__title { display:flex; align-items:center; gap:12rpx; margin-bottom:16rpx; font-size:28rpx; font-weight:700; color:var(--color-text); }
.teacher-mgmt__bar { width:6rpx; height:26rpx; border-radius:4rpx; background:var(--color-primary); flex-shrink:0; }
.teacher-mgmt__empty { padding:24rpx 0; text-align:center; color:var(--color-muted); font-size:24rpx; }

.teacher-row { display:flex; align-items:center; gap:20rpx; padding:20rpx; margin-bottom:16rpx; background:var(--color-card); border:1rpx solid var(--color-line); border-radius:var(--radius-base); }
.teacher-row__avatar { width:80rpx; height:80rpx; border-radius:50%; flex-shrink:0; }
.teacher-row__avatar--placeholder { display:flex; align-items:center; justify-content:center; background:var(--color-primary-light); color:var(--color-primary); font-size:32rpx; font-weight:700; }
.teacher-row__info { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.teacher-row__name { font-size:28rpx; font-weight:700; color:var(--color-text); }
.teacher-row__sub { font-size:22rpx; color:var(--color-muted); }
.teacher-row__remove, .teacher-row__self { flex-shrink:0; font-size:24rpx; font-weight:600; padding:8rpx 22rpx; border-radius:999rpx; }
.teacher-row__remove { color:var(--color-danger); background:rgba(192, 57, 43, 0.08); }
.teacher-row__self { color:var(--color-gold); background:var(--color-gold-light); }

.teacher-select { position:relative; }
.teacher-picker { display:flex; align-items:center; justify-content:space-between; gap:16rpx; height:80rpx; padding:0 24rpx; border:1rpx solid var(--color-line); border-radius:var(--radius-base); background:var(--color-card); }
.teacher-picker__value { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:26rpx; color:var(--color-text); }
.teacher-picker__value--placeholder { color:var(--color-muted); }
.teacher-picker__arrow { flex-shrink:0; color:var(--color-muted); font-size:28rpx; line-height:1; transition:transform 0.15s ease; }
.teacher-picker__arrow--open { transform:rotate(180deg); }

.teacher-dropdown { position:absolute; left:0; right:0; top:88rpx; z-index:20; border:1rpx solid var(--color-line); border-radius:var(--radius-base); background:var(--color-card); box-shadow:0 12rpx 32rpx rgba(0,0,0,0.10); overflow:hidden; }
.teacher-dropdown__search { padding:16rpx; border-bottom:1rpx solid var(--color-line); }
.teacher-dropdown__input { box-sizing:border-box; width:100%; height:64rpx; padding:0 20rpx; border:1rpx solid var(--color-line); border-radius:var(--radius-base); background:var(--color-surface); font-size:26rpx; }
.teacher-dropdown__list { max-height:420rpx; }
.teacher-dropdown__status { padding:32rpx 24rpx; text-align:center; color:var(--color-muted); font-size:24rpx; }
.teacher-dropdown__item { display:flex; align-items:center; gap:16rpx; padding:20rpx 24rpx; border-bottom:1rpx solid var(--color-line); }
.teacher-dropdown__item:last-child { border-bottom:none; }
.teacher-dropdown__info { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.teacher-dropdown__name { font-size:26rpx; font-weight:600; color:var(--color-text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.teacher-dropdown__sub { font-size:22rpx; color:var(--color-muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.teacher-dropdown__add { flex-shrink:0; font-size:24rpx; font-weight:600; padding:8rpx 22rpx; border-radius:999rpx; color:var(--color-primary-dark); background:var(--color-primary-light); }

/* 提交审批：浅绿底 + 细边框 + 深绿字，覆盖全局 .btn-primary 的深绿实底 */
.record-actions .btn-primary {
  border:1rpx solid rgba(66,109,88,0.28);
  background:rgba(66,109,88,0.06);
  color:var(--color-primary-dark);
  font-weight:500;
  box-shadow:none;
}
.record-actions .btn-primary:active {
  background:rgba(66,109,88,0.06);
  opacity:0.82;
  transform:none;
}
@media (prefers-color-scheme: dark) {
  .record-actions .btn-primary {
    border-color:rgba(119,154,132,0.34);
    background:rgba(66,109,88,0.14);
    color:#b9d2c0;
  }
}
