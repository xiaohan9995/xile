/* ===== Teacher Home (我的认证) — Prototype Match ===== */
.teacher-home-page {
  padding-top: 0;
}

.home-body {
  padding: 0 32rpx;
}

/* ---- Mine Card ---- */
.mine-card {
  position: relative;
  display: grid;
  grid-template-columns: 128rpx 1fr;
  gap: 28rpx;
  padding: 28rpx;
  border-radius: var(--radius-base);
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  background: #fff;
  margin-top: 24rpx;
}

.mine-card__content {
  display: grid;
  grid-template-columns: 128rpx 1fr;
  gap: 28rpx;
  grid-column: 1 / -1;
  align-items: center;
}

.mine-card__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.mine-card__avatar--fallback { display:flex; align-items:center; justify-content:center; background:var(--color-primary-light); color:var(--color-primary); font-size:46rpx; font-weight:600; }

.mine-card__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mine-card__greeting {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.mine-card__tier-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mine-card__tier-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--color-gold);
}

.mine-card__tier-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.mine-card__valid {
  font-size: 22rpx;
  color: var(--color-muted);
}

/* ---- Metric Row ---- */
.metric-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 24rpx 0;
}

.review-task-card { display:flex; align-items:flex-start; gap:18rpx; margin:0 0 24rpx; padding:26rpx; border-radius:var(--radius-base); background:#fff; border:1rpx solid var(--color-line); }
.review-task-card__seal { width:64rpx; height:64rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; border:1rpx solid var(--color-gold); border-radius:50%; color:var(--color-gold); font-family:"Noto Serif SC", serif; font-size:20rpx; font-weight:700; }
.review-task-card__body { min-width:0; flex:1; }
.review-task-card__eyebrow,.review-task-card__hint { display:block; color:var(--color-muted); font-size:22rpx; }
.review-task-card__title { display:block; margin-top:6rpx; color:var(--color-text); font-size:30rpx; font-weight:700; }
.review-task-card__hint { margin-top:6rpx; }
.review-task-card__action { max-width:130rpx; flex-shrink:0; color:var(--color-primary-dark); font-size:23rpx; font-weight:700; text-align:right; line-height:1.45; }
.review-task-card__action text { display:block; font-size:34rpx; }
.review-task-card__rail { display:flex; align-items:center; width:124rpx; margin-top:16rpx; }
.review-task-card__rail-dot { width:12rpx; height:12rpx; border-radius:50%; background:var(--color-primary); }
.review-task-card__rail-dot--muted { background:#d8c8a7; }
.review-task-card__rail-line { height:2rpx; flex:1; background:linear-gradient(90deg,var(--color-primary),#d8c8a7); }

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  text-align: center;
  border: 1rpx solid rgba(31, 37, 33, 0.08);
  border-radius: var(--radius-base);
  background: #fff;
}

.metric-label {
  font-size: 24rpx;
  color: var(--color-muted);
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2521;
}

/* ---- Menu List ---- */
.menu-list {
  display: grid;
  gap: 0;
  padding: 0 24rpx;
  background: #fff;
}

.menu-item {
  display: grid;
  grid-template-columns: 56rpx 1fr 36rpx;
  align-items: center;
  height: 104rpx;
  border-bottom: 1rpx solid var(--color-line);
  background: transparent;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-item__icon {
  width: 50rpx;
  height: 40rpx;
  border-radius: 8rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  font-size: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-item__label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2521;
}

.menu-item__arrow {
  font-size: 32rpx;
  color: var(--color-muted);
  text-align: right;
}

.menu-item--logout {
  margin-top: 24rpx;
  border-bottom: none;
}

.menu-item--logout .menu-item__label {
  color: #c84a4a;
}
