/* ===== Teacher Home (我的认证) — Prototype Match ===== */
.teacher-home-page {
  padding-top: 0;
}

.home-body {
  padding: 0 32rpx;
}

/* ---- Mine Card ---- */
.mine-card {
  position: relative;
  display: grid;
  grid-template-columns: 128rpx 1fr;
  gap: 28rpx;
  padding: 28rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 0;
  margin-top: 24rpx;
}

.mine-card__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.mine-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(95, 115, 101, 0.95), rgba(132, 148, 129, 0.94));
}

.mine-card__content {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 128rpx 1fr;
  gap: 28rpx;
  grid-column: 1 / -1;
  align-items: center;
}

.mine-card__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.mine-card__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mine-card__greeting {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.mine-card__tier-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mine-card__tier-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--color-gold);
}

.mine-card__tier-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.mine-card__valid {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* ---- Metric Row ---- */
.metric-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 24rpx 0;
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  text-align: center;
  border: 1rpx solid rgba(31, 37, 33, 0.08);
  border-radius: var(--radius-xl);
  background: #fff;
}

.metric-label {
  font-size: 24rpx;
  color: var(--color-muted);
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2521;
}

/* ---- Menu List ---- */
.menu-list {
  display: grid;
  gap: 8rpx;
}

.menu-item {
  display: grid;
  grid-template-columns: 56rpx 1fr 36rpx;
  align-items: center;
  height: 92rpx;
  border-bottom: 1rpx solid rgba(31, 37, 33, 0.08);
  background: transparent;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-item__icon {
  font-size: 36rpx;
  color: var(--color-primary-dark);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-item__label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2521;
}

.menu-item__arrow {
  font-size: 32rpx;
  color: var(--color-muted);
  text-align: right;
}

.menu-item--logout {
  margin-top: 24rpx;
  border-bottom: none;
}

.menu-item--logout .menu-item__label {
  color: #c84a4a;
}
