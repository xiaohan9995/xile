<view class="page-shell teacher-home-page">
  <!-- Header -->
  <view class="page-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="page-header__back" bindtap="goBack">‹</view>
    <text class="page-header__title">我的认证</text>
    <view class="page-header__right"></view>
  </view>

  <view class="home-body">
    <!-- Mine Card -->
    <view class="mine-card">
      <image class="mine-card__bg" src="https://images.unsplash.com/photo-1545205597-3d9d02c29597?q=80&w=600&auto=format&fit=crop" mode="aspectFill" />
      <view class="mine-card__overlay"></view>
      <view class="mine-card__content">
        <image class="mine-card__avatar" src="{{teacher.avatarUrl}}" mode="aspectFill" />
        <view class="mine-card__info">
          <text class="mine-card__greeting">您好，{{teacher.name}}老师</text>
          <view class="mine-card__tier-row">
            <view class="mine-card__tier-dot"></view>
            <text class="mine-card__tier-label">{{teacher.tierName}}</text>
          </view>
          <text class="mine-card__valid">认证有效</text>
        </view>
      </view>
    </view>

    <view class="review-task-card" bindtap="goReviewCenter">
      <view class="review-task-card__seal">年审</view>
      <view class="review-task-card__body"><text class="review-task-card__eyebrow">本期年审 · 当前进度</text><text class="review-task-card__title">{{review.statusText}}</text><text class="review-task-card__hint">{{review.hint}}</text><view class="review-task-card__rail"><view class="review-task-card__rail-dot"></view><view class="review-task-card__rail-line"></view><view class="review-task-card__rail-dot review-task-card__rail-dot--muted"></view></view></view>
      <view class="review-task-card__action">{{review.actionText}}<text>›</text></view>
    </view>

    <!-- Metric Row -->
    <view class="metric-row">
      <view class="metric-item">
        <text class="metric-label">认证等级</text>
        <text class="metric-value">{{teacher.tier}}</text>
      </view>
      <view class="metric-item">
        <text class="metric-label">到期天数</text>
        <text class="metric-value">{{teacher.daysLeft}}</text>
      </view>
    </view>

    <!-- Menu List -->
    <view class="menu-list">
      <view class="menu-item" bindtap="goProfile">
        <view class="menu-item__icon">👤</view>
        <text class="menu-item__label">个人资料</text>
        <text class="menu-item__arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goReviewRecords">
        <view class="menu-item__icon">📋</view>
        <text class="menu-item__label">年审记录</text>
        <text class="menu-item__arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goTeachingRecords">
        <view class="menu-item__icon">📚</view>
        <text class="menu-item__label">教学记录</text>
        <text class="menu-item__arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goCertView">
        <view class="menu-item__icon">🏅</view>
        <text class="menu-item__label">证书查看</text>
        <text class="menu-item__arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goUsageGuide">
        <view class="menu-item__icon">💡</view>
        <text class="menu-item__label">使用指引</text>
        <text class="menu-item__arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goReviewApply">
        <view class="menu-item__icon">📝</view>
        <text class="menu-item__label">提交年审</text>
        <text class="menu-item__arrow">›</text>
      </view>
      <view class="menu-item menu-item--logout" bindtap="onLogout">
        <view class="menu-item__icon">🚪</view>
        <text class="menu-item__label">退出登录</text>
        <text class="menu-item__arrow">›</text>
      </view>
    </view>
  </view>
<tab-bar active="my" />
</view>
