{
  "envId": "{{env.ENV_ID}}",
  "cloudrun": {
    "name": "xile-yoga"
  },
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "mp-auth-bridge",
      "handler": "index.main",
      "runtime": "Nodejs18.15",
      "timeout": 10,
      "memorySize": 128,
      "installDependency": true,
      "envVariables": {
        "CLOUDBASE_AUTH_BRIDGE_SECRET": "{{env.CLOUDBASE_AUTH_BRIDGE_SECRET}}"
      },
      "ignore": ["node_modules/**", ".git/**"]
    }
  ],
  "ai": {
    "defaultAgent": "{{env.AI_DEFAULT_AGENT}}",
    "agents": {
      "codebuddy": {
        "type": "none"
      }
    }
  }
}
